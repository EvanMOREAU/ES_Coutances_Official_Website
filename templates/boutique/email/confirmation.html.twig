{% extends 'boutique/email/_base.html.twig' %}

{% block contenu %}
    <p>{{ 'Merci pour votre commande'|trans }} <strong>{{ commande.reference }}</strong>{{ '. Elle est bien enregistrée.'|trans }}</p>

    <table style="width:100%; border-collapse:collapse; margin:16px 0;">
        {% for ligne in commande.lignes %}
            <tr>
                <td style="padding:6px 0; border-bottom:1px solid #eee;">{{ ligne.quantite }} × {{ ligne.libelle }}</td>
                <td style="padding:6px 0; border-bottom:1px solid #eee; text-align:right;">{{ ligne.totalCentimes|money }}</td>
            </tr>
        {% endfor %}
        <tr>
            <td style="padding:10px 0; font-weight:700;">{{ 'Total'|trans }}</td>
            <td style="padding:10px 0; font-weight:700; text-align:right;">{{ commande.totalCentimes|money }}</td>
        </tr>
    </table>

    <p><strong>{{ 'Retrait au club'|trans }}</strong> {{ ': il n\'y a pas de livraison. Nous vous prévenons par email dès que votre commande est prête.'|trans }}</p>
    {% if commande.isPayee %}
        <p>{{ 'Règlement :'|trans }} <strong>{{ 'payé'|trans }}</strong> ({{ commande.modePaiementLabel|lower }}).</p>
    {% elseif commande.modePaiement == 'carte' %}
        <p>{{ 'Règlement par carte :'|trans }} <strong>{{ 'en attente'|trans }}</strong>{{ '. Vous pouvez le finaliser depuis la page de suivi ci-dessous.'|trans }}</p>
    {% else %}
        <p>{{ 'Règlement :'|trans }} <strong>{{ commande.modePaiementLabel|lower }}</strong>, <strong>{{ commande.totalCentimes|money }}</strong> {{ 'à régler lors du retrait.'|trans }}</p>
    {% endif %}

    <p style="text-align:center; margin:28px 0;">
        <a href="{{ url('boutique_commande_suivi', {reference: commande.reference, token: commande.token}) }}"
           style="background:#C8102E; color:#fff; padding:12px 26px; border-radius:4px; text-decoration:none; font-weight:700; text-transform:uppercase; letter-spacing:.05em; font-size:13px;">
            {{ 'Suivre ma commande'|trans }}
        </a>
    </p>
{% endblock %}
