{% extends 'boutique/_layout.html.twig' %}

{% block boutique_title %}Commande {{ commande.reference }}{% endblock %}
{% block breadcrumb %}<a href="{{ path('boutique_index') }}">Boutique</a> <i class="fa-solid fa-chevron-right"></i> <span>Commande {{ commande.reference }}</span>{% endblock %}
{% block hero_title %}Ma <span>commande</span>{% endblock %}
{% block hero_lead %}<p class="lead">Référence {{ commande.reference }} · passée le {{ commande.createdAt|date('d/m/Y à H:i') }}</p>{% endblock %}

{% block boutique_styles %}
<style>
.track { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin-bottom: 8px; }
.track li { position: relative; text-align: center; padding-top: 44px; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 14px; letter-spacing: .08em; text-transform: uppercase; color: #aaa; }
.track li::before { content: ''; position: absolute; top: 15px; left: -50%; width: 100%; height: 3px; background: var(--border); z-index: 0; }
.track li:first-child::before { display: none; }
.track li .dot { position: absolute; top: 0; left: 50%; transform: translateX(-50%); z-index: 1; display: flex; width: 34px; height: 34px; align-items: center; justify-content: center; border-radius: 50%; background: var(--grey); color: #aaa; font-size: 14px; }
.track li.is-done, .track li.is-current { color: var(--dark); }
.track li.is-done::before, .track li.is-current::before { background: #16a34a; }
.track li.is-done .dot { background: #16a34a; color: #fff; }
.track li.is-current .dot { background: var(--red); color: #fff; box-shadow: 0 0 0 5px rgba(200,16,46,.15); }
.track li small { display: block; font-family: 'Inter', sans-serif; font-weight: 400; font-size: 12px; letter-spacing: 0; text-transform: none; color: #888; }
.order-line { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-top: 1px solid var(--border); font-size: 14px; }
.order-line:first-of-type { border-top: 0; }
.callout { display: flex; gap: 14px; padding: 16px 18px; border-radius: 8px; margin-bottom: 24px; border: 1px solid; }
.callout i { font-size: 20px; margin-top: 2px; }
.callout strong { display: block; font-size: 15px; }
.callout.ready { background: #eff6ff; border-color: #bfdbfe; color: #1e3a8a; }
.callout.due { background: #fffbeb; border-color: #fde68a; color: #78350f; }
.callout.done { background: #f0fdf4; border-color: #bbf7d0; color: #14532d; }
.callout.cancelled { background: #fef2f2; border-color: #fecaca; color: #7f1d1d; }
</style>
{% endblock %}

{% block shop_body %}
  {% set statut = commande.statut %}

  {% if statut == 'annulee' %}
    <div class="callout cancelled"><i class="fa-solid fa-circle-xmark"></i><div><strong>Commande annulée</strong>Cette commande a été annulée. Pour toute question, contactez le club.</div></div>
  {% elseif statut == 'retiree' %}
    <div class="callout done"><i class="fa-solid fa-circle-check"></i><div><strong>Commande retirée</strong>Merci pour votre achat, et à bientôt au stade !</div></div>
  {% elseif statut == 'prete' %}
    <div class="callout ready"><i class="fa-solid fa-box-open"></i><div><strong>Votre commande est prête !</strong>Vous pouvez venir la retirer au club en indiquant la référence <strong style="display:inline">{{ commande.reference }}</strong>.{% if not commande.payee %} Règlement à prévoir : {{ commande.totalCentimes|money }} ({{ commande.modePaiementLabel|lower }}).{% endif %}</div></div>
  {% elseif not commande.payee and commande.modePaiement == 'carte' %}
    <div class="callout due">
      <i class="fa-solid fa-credit-card"></i>
      <div>
        <strong>Paiement par carte en attente</strong>
        Votre commande est réservée, mais son règlement n'est pas finalisé.
        <p style="margin-top:12px;"><a class="btn btn-primary" href="{{ path('boutique_paiement', {reference: commande.reference, token: commande.token}) }}">Payer {{ commande.totalCentimes|money }}</a></p>
      </div>
    </div>
  {% elseif not commande.payee %}
    <div class="callout due"><i class="fa-solid fa-hourglass-half"></i><div><strong>Règlement à effectuer au club</strong>Merci de prévoir <strong style="display:inline">{{ commande.totalCentimes|money }}</strong> en {{ commande.modePaiement == 'cheque' ? 'chèque (à l\'ordre de l\'ES Coutances)' : 'espèces' }} lors du retrait. Nous vous prévenons par e-mail dès que votre commande est prête.</div></div>
  {% else %}
    <div class="callout done"><i class="fa-solid fa-circle-check"></i><div><strong>Commande enregistrée et payée</strong>Nous vous prévenons par e-mail dès qu'elle est prête à être retirée au club.</div></div>
  {% endif %}

  {% if statut != 'annulee' %}
    <div class="box" style="margin-bottom:24px;">
      <ol class="track">
        <li class="is-done"><span class="dot"><i class="fa-solid fa-check"></i></span>Commande reçue<small>{{ commande.createdAt|date('d/m à H:i') }}</small></li>
        <li class="{{ statut == 'nouvelle' ? 'is-current' : 'is-done' }}"><span class="dot"><i class="fa-solid {{ statut == 'nouvelle' ? 'fa-box-open' : 'fa-check' }}"></i></span>{{ statut == 'nouvelle' ? 'En préparation' : 'Prête' }}</li>
        <li class="{{ statut == 'retiree' ? 'is-done' : (statut == 'prete' ? 'is-current' : '') }}"><span class="dot"><i class="fa-solid {{ statut == 'retiree' ? 'fa-check' : 'fa-store' }}"></i></span>Retirée au club</li>
      </ol>
    </div>
  {% endif %}

  <div class="shop-cols">
    <div class="box">
      <h2>Détail</h2>
      {% for ligne in commande.lignes %}
        <div class="order-line"><span>{{ ligne.quantite }} × {{ ligne.libelle }}</span><span>{{ ligne.totalCentimes|money }}</span></div>
      {% endfor %}
      <div class="sum-row total"><span>Total</span><span class="price">{{ commande.totalCentimes|money }}</span></div>
    </div>

    <aside class="box">
      <h2>Informations</h2>
      <div class="sum-row"><span>Statut</span><span class="tag {{ {nouvelle: 'tag-wait', prete: 'tag-blue', retiree: 'tag-ok', annulee: 'tag-ko'}[statut] }}">{{ commande.statutLabel }}</span></div>
      <div class="sum-row"><span>Règlement</span><span class="tag {{ commande.payee ? 'tag-ok' : 'tag-wait' }}">{{ commande.payee ? 'Payée' : 'En attente' }}</span></div>
      <div class="sum-row"><span>Mode</span><span>{{ commande.modePaiementLabel }}</span></div>
      <div class="sum-row"><span>Client</span><span>{{ commande.nomComplet }}</span></div>
      <div class="sum-row"><span>E-mail</span><span style="overflow-wrap:anywhere; text-align:right;">{{ commande.email }}</span></div>
      <p class="note" style="margin-top:14px;"><i class="fa-solid fa-store"></i> Retrait au club, sans livraison.</p>
      <p style="margin-top:18px;"><a class="btn btn-outline btn-block" href="{{ path('boutique_index') }}">Retour à la boutique</a></p>
    </aside>
  </div>
{% endblock %}
