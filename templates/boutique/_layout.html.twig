{% extends 'base.html.twig' %}

{% block title %}{% block boutique_title %}Boutique{% endblock %} — ES Coutances{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ============================================================
   BOUTIQUE — page hero (même gabarit que les pages « Club »)
   ============================================================ */
.page-hero { background: var(--dark); position: relative; overflow: hidden; padding: 56px 0 48px; }
.page-hero::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(200,16,46,.15) 0%, transparent 60%); pointer-events: none; }
.page-hero::after { content: ''; position: absolute; bottom: 0; left: 0; width: 100%; height: 0; border-style: solid; border-width: 0 0 40px 180px; border-color: transparent transparent var(--red) transparent; }
.page-hero-inner { position: relative; z-index: 2; }
.breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.45); margin-bottom: 16px; }
.breadcrumb a { color: rgba(255,255,255,.45); transition: color .15s; }
.breadcrumb a:hover { color: var(--red); }
.breadcrumb i { font-size: 9px; }
.page-hero h1 { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: clamp(36px, 6vw, 68px); line-height: .95; letter-spacing: .02em; text-transform: uppercase; color: var(--white); }
.page-hero h1 span { color: var(--red); }
.page-hero p.lead { margin-top: 12px; max-width: 560px; color: rgba(255,255,255,.7); font-size: 15px; }

.shop { padding: 48px 0 72px; min-height: 50vh; }

/* Messages */
.shop-flash { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 20px; padding: 12px 16px; border-radius: 6px; font-size: 14px; border: 1px solid; }
.shop-flash i { margin-top: 3px; }
.shop-flash.success { color: #166534; background: #f0fdf4; border-color: #bbf7d0; }
.shop-flash.warning { color: #92400e; background: #fffbeb; border-color: #fde68a; }
.shop-flash.error { color: #991b1b; background: #fef2f2; border-color: #fecaca; }

/* Boutons */
.shop .btn[disabled] { opacity: .5; cursor: not-allowed; transform: none; }
.btn-block { display: flex; width: 100%; justify-content: center; }
.btn-ghost { background: transparent; color: var(--mid); border: 1px solid var(--border); }
.btn-ghost:hover { border-color: var(--red); color: var(--red); }

/* Prix, badges */
.price { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 22px; color: var(--dark); }
.tag { display: inline-block; padding: 2px 10px; border-radius: 999px; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
.tag-red { background: var(--red); color: #fff; }
.tag-grey { background: var(--grey); color: var(--mid); }
.tag-ok { background: #dcfce7; color: #166534; }
.tag-wait { background: #fef3c7; color: #92400e; }
.tag-blue { background: #dbeafe; color: #1e40af; }
.tag-ko { background: #fee2e2; color: #991b1b; }

/* Cartes & formulaires */
.box { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 24px; }
.box h2 { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 20px; letter-spacing: .04em; text-transform: uppercase; color: var(--dark); margin-bottom: 16px; }
.shop-cols { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 32px; align-items: start; }
@media (max-width: 900px) { .shop-cols { grid-template-columns: minmax(0, 1fr); } }
.sum-row { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; font-size: 14px; }
.sum-row.total { border-top: 1px solid var(--border); margin-top: 8px; padding-top: 14px; font-weight: 700; font-size: 16px; }
.sum-row.total .price { font-size: 26px; color: var(--red); }
.note { font-size: 13px; color: #666; }
.note i { color: var(--red); margin-right: 6px; }

/* Étapes de la commande */
.steps { list-style: none; display: flex; gap: 8px; margin-bottom: 32px; flex-wrap: wrap; }
.steps li { display: flex; align-items: center; gap: 8px; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: #999; }
.steps li + li::before { content: ''; width: 28px; height: 2px; background: var(--border); }
.steps .n { display: inline-flex; width: 24px; height: 24px; align-items: center; justify-content: center; border-radius: 50%; background: var(--grey); color: var(--mid); font-size: 12px; }
.steps .is-done, .steps .is-current { color: var(--dark); }
.steps .is-done .n { background: #16a34a; color: #fff; }
.steps .is-current .n { background: var(--red); color: #fff; }
</style>
{% block boutique_styles %}{% endblock %}
{% endblock %}

{% block body %}
<section class="page-hero">
  <div class="container page-hero-inner">
    <nav class="breadcrumb" aria-label="Fil d'Ariane">
      <a href="{{ path('app_home') }}">Accueil</a> <i class="fa-solid fa-chevron-right"></i>
      {% block breadcrumb %}<span>Boutique</span>{% endblock %}
    </nav>
    <h1>{% block hero_title %}La <span>boutique</span>{% endblock %}</h1>
    {% block hero_lead %}{% endblock %}
  </div>
</section>

<main class="shop">
  <div class="container">
    {% if boutique_en_maintenance() and is_granted('ROLE_DEV') %}
      <div class="shop-flash warning" role="status">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>Cette boutique n'est pas publiée — vous la voyez uniquement parce que vous êtes développeur.</span>
      </div>
    {% endif %}

    {% for type in ['success', 'warning', 'error'] %}
      {% for message in app.flashes('boutique_' ~ type) %}
        <div class="shop-flash {{ type }}" role="{{ type == 'error' ? 'alert' : 'status' }}">
          <i class="fa-solid {{ type == 'success' ? 'fa-circle-check' : 'fa-triangle-exclamation' }}"></i>
          <span>{{ message }}</span>
        </div>
      {% endfor %}
    {% endfor %}

    {% block shop_body %}{% endblock %}
  </div>
</main>
{{ importmap('public') }}
{% endblock %}
