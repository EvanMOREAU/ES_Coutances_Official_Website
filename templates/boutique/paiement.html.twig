{% extends 'boutique/_layout.html.twig' %}

{% block boutique_title %}Paiement{% endblock %}
{% block breadcrumb %}<a href="{{ path('boutique_index') }}">Boutique</a> <i class="fa-solid fa-chevron-right"></i> <span>Paiement</span>{% endblock %}
{% block hero_title %}Paiement par <span>carte</span>{% endblock %}

{% block boutique_styles %}
<style>
.pay-wrap { max-width: 520px; margin: 0 auto; }
.pay-sim { display: flex; gap: 10px; padding: 12px 14px; margin-bottom: 20px; border-radius: 6px; background: #fffbeb; border: 1px dashed #f59e0b; color: #78350f; font-size: 13px; }
.pay-sim i { margin-top: 2px; }
.pay-amount { text-align: center; padding: 8px 0 20px; }
.pay-amount small { display: block; font-size: 13px; color: #777; }
.pay-amount .price { font-size: 46px; color: var(--red); }
.pay-form .f { margin-bottom: 12px; }
.pay-form label { display: block; margin-bottom: 4px; font-size: 12px; font-weight: 600; color: #777; text-transform: uppercase; letter-spacing: .06em; }
.pay-form input { width: 100%; padding: 11px 14px; border: 1.5px solid var(--border); border-radius: 6px; font: 400 15px 'Inter', sans-serif; background: #f9f9f9; color: #999; }
.pay-form .two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.pay-actions { display: grid; gap: 10px; margin-top: 18px; }
</style>
{% endblock %}

{% block shop_body %}
  <ol class="steps">
    <li class="is-done"><span class="n"><i class="fa-solid fa-check" style="font-size:11px"></i></span> Panier</li>
    <li class="is-done"><span class="n"><i class="fa-solid fa-check" style="font-size:11px"></i></span> Vos informations</li>
    <li class="is-current"><span class="n">3</span> Paiement</li>
  </ol>

  <div class="pay-wrap">
    <div class="box">
      <div class="pay-sim">
        <i class="fa-solid fa-flask"></i>
        <span><strong>Paiement fictif.</strong> Le règlement par carte passera bientôt par HelloAsso. En attendant, cette page simule le paiement : aucune somme n'est débitée.</span>
      </div>

      <div class="pay-amount">
        <small>Commande {{ commande.reference }}</small>
        <span class="price">{{ commande.totalCentimes|money }}</span>
      </div>

      <div class="pay-form" aria-hidden="true">
        <div class="f"><label>Numéro de carte</label><input type="text" value="4242 4242 4242 4242" disabled></div>
        <div class="two">
          <div class="f"><label>Expiration</label><input type="text" value="12 / 30" disabled></div>
          <div class="f"><label>Cryptogramme</label><input type="text" value="123" disabled></div>
        </div>
      </div>

      <form method="post" class="pay-actions">
        <input type="hidden" name="_token" value="{{ csrf_token('boutique-paiement-' ~ commande.id) }}">
        <button type="submit" class="btn btn-primary btn-block"><i class="fa-solid fa-lock"></i> Payer {{ commande.totalCentimes|money }}</button>
        <a href="{{ path('boutique_commande_suivi', {reference: commande.reference, token: commande.token}) }}" class="btn btn-ghost btn-block">Payer plus tard</a>
      </form>
      <p class="note" style="margin-top:14px; text-align:center;">Votre commande reste réservée. Vous pourrez régler depuis la page de suivi.</p>
    </div>
  </div>
{% endblock %}
