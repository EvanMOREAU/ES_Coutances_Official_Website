{% block body %}
<!DOCTYPE html>
<html lang="fr" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <title>Connexion — ES Coutances Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="admin-shell h-full bg-admin-bg text-admin-text flex items-center justify-center p-4">
    <div class="w-full max-w-md">
        <div class="admin-hero relative overflow-hidden rounded-2xl p-8 mb-6 text-center">
            <div class="admin-hero-glow"></div>
            <div class="relative">
                <img src="https://raw.githubusercontent.com/CylaosICT/escoutances-images/refs/heads/main/logo_hd_trans3_gt.png" alt="ES Coutances" class="h-14 mx-auto mb-3">
                <h1 class="text-xl font-black text-white uppercase tracking-wide" style="font-family:'Barlow Condensed',sans-serif;">Espace Administration</h1>
            </div>
        </div>

        <div class="admin-card rounded-2xl p-8">
            {% for message in app.flashes('success') %}
                <div class="mb-4 rounded-lg border border-admin-success/30 bg-admin-success/10 text-admin-success px-4 py-3 text-sm">{{ message }}</div>
            {% endfor %}
            {% if error %}
                <div class="mb-4 rounded-lg border border-admin-danger/30 bg-admin-danger/10 text-admin-danger px-4 py-3 text-sm">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" class="space-y-5">
                <div>
                    <label for="email" class="block text-xs font-semibold uppercase tracking-wide text-admin-text-muted mb-1.5">Adresse e-mail</label>
                    <input type="email" id="email" name="email" value="{{ last_username }}" autocomplete="email" required
                           class="w-full rounded-lg border border-admin-border bg-admin-bg px-3 py-2 text-sm text-admin-text focus:outline-none focus:ring-2 focus:ring-admin-primary-to">
                </div>
                <div>
                    <label for="password" class="block text-xs font-semibold uppercase tracking-wide text-admin-text-muted mb-1.5">Mot de passe</label>
                    <input type="password" id="password" name="password" autocomplete="current-password" required
                           class="w-full rounded-lg border border-admin-border bg-admin-bg px-3 py-2 text-sm text-admin-text focus:outline-none focus:ring-2 focus:ring-admin-primary-to">
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="w-full rounded-lg admin-gradient px-5 py-2.5 text-sm font-semibold text-white">
                    Se connecter
                </button>
            </form>

            <div class="mt-5 pt-5 border-t border-admin-border" data-controller="passkey"
                 data-passkey-options-url-value="{{ path('admin_webauthn_login_options') }}"
                 data-passkey-finish-url-value="{{ path('admin_webauthn_login_check') }}">
                <button type="button" data-passkey-target="button" data-action="click->passkey#login"
                        class="w-full rounded-lg border border-admin-border px-5 py-2.5 text-sm font-semibold text-admin-text hover:bg-admin-surface">
                    <i class="fa-solid fa-fingerprint mr-1"></i> Se connecter avec une clé d'accès
                </button>
                <p data-passkey-target="status" class="mt-2 text-xs text-admin-danger text-center"></p>
            </div>

            <a href="{{ path('app_forgot_password_request') }}" class="block text-center mt-5 text-sm text-admin-text-muted hover:text-white">Mot de passe oublié ?</a>
        </div>
    </div>
</body>
</html>
{% endblock %}
