{% block body %}
<!DOCTYPE html>
<html lang="fr" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="csp-nonce" content="{{ csp_nonce() }}">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <title>Mot de passe oublié — ES Coutances</title>
    <link rel="stylesheet" href="{{ asset('fonts/fonts.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="admin-shell h-full bg-admin-bg text-admin-text flex items-center justify-center p-4">
    <div class="w-full max-w-md">
        <div class="admin-hero relative overflow-hidden rounded-2xl p-8 mb-6 text-center">
            <div class="admin-hero-glow"></div>
            <div class="relative">
                <img src="{{ asset('images/logo_hd_trans3_gt.png') }}" alt="ES Coutances" class="h-14 mx-auto mb-3">
                <h1 class="text-xl font-black text-white uppercase tracking-wide" style="font-family:'Barlow Condensed',sans-serif;">Mot de passe oublié</h1>
            </div>
        </div>

        <div class="admin-card rounded-2xl p-8">
            {% for flash_error in app.flashes('reset_password_error') %}
                <div class="mb-4 rounded-lg border border-admin-danger/30 bg-admin-danger/10 text-admin-danger px-4 py-3 text-sm">{{ flash_error }}</div>
            {% endfor %}

            <p class="text-sm text-admin-text-muted mb-5">Indiquez votre adresse e-mail. Si un compte lui correspond, vous recevrez un lien pour définir un nouveau mot de passe.</p>

            {{ form_start(requestForm) }}
                <label for="{{ requestForm.email.vars.id }}" class="block text-xs font-semibold uppercase tracking-wide text-admin-text-muted mb-1.5">Adresse e-mail</label>
                {{ form_widget(requestForm.email, { attr: { autocomplete: 'email', autofocus: true, class: 'w-full rounded-lg border border-admin-border bg-admin-bg px-3 py-2 text-sm text-admin-text focus:outline-none focus:ring-2 focus:ring-admin-primary-to mb-5' } }) }}

                <button type="submit" class="w-full rounded-lg admin-gradient px-5 py-2.5 text-sm font-semibold text-white">Envoyer le lien</button>
            {{ form_end(requestForm) }}

            <div class="flex flex-col items-center gap-1 mt-5 text-sm text-admin-text-muted">
                <a href="{{ path('app_login') }}" class="hover:text-white">&larr; Connexion espace administration</a>
                <a href="{{ path('portail_login') }}" class="hover:text-white">&larr; Connexion espace familles &amp; licenciés</a>
            </div>
        </div>
    </div>
</body>
</html>
{% endblock %}
