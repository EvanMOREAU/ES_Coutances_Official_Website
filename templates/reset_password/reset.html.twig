{% block body %}
<!DOCTYPE html>
<html lang="fr" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <title>Nouveau mot de passe — ES Coutances</title>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="admin-shell h-full bg-admin-bg text-admin-text flex items-center justify-center p-4">
    <div class="w-full max-w-md">
        <div class="admin-hero relative overflow-hidden rounded-2xl p-8 mb-6 text-center">
            <div class="admin-hero-glow"></div>
            <div class="relative">
                <img src="https://raw.githubusercontent.com/CylaosICT/escoutances-images/refs/heads/main/logo_hd_trans3_gt.png" alt="ES Coutances" class="h-14 mx-auto mb-3">
                <h1 class="text-xl font-black text-white uppercase tracking-wide" style="font-family:'Barlow Condensed',sans-serif;">Nouveau mot de passe</h1>
            </div>
        </div>

        <div class="admin-card rounded-2xl p-8">
            {% for flash_error in app.flashes('reset_password_error') %}
                <div class="mb-4 rounded-lg border border-admin-danger/30 bg-admin-danger/10 text-admin-danger px-4 py-3 text-sm">{{ flash_error }}</div>
            {% endfor %}

            {% set field_class = 'w-full rounded-lg border border-admin-border bg-admin-bg px-3 py-2 text-sm text-admin-text focus:outline-none focus:ring-2 focus:ring-admin-primary-to mb-1.5' %}

            {{ form_start(resetForm) }}
                <label for="{{ resetForm.plainPassword.first.vars.id }}" class="block text-xs font-semibold uppercase tracking-wide text-admin-text-muted mb-1.5">Nouveau mot de passe</label>
                {{ form_widget(resetForm.plainPassword.first, { attr: { autofocus: true, class: field_class } }) }}
                <p class="text-xs text-admin-text-muted mb-4">12 caractères minimum.</p>

                <label for="{{ resetForm.plainPassword.second.vars.id }}" class="block text-xs font-semibold uppercase tracking-wide text-admin-text-muted mb-1.5">Confirmer le mot de passe</label>
                {{ form_widget(resetForm.plainPassword.second, { attr: { class: field_class } }) }}

                <div class="text-xs text-admin-danger mt-1 mb-4">{{ form_errors(resetForm.plainPassword) }}</div>

                <button type="submit" class="w-full rounded-lg admin-gradient px-5 py-2.5 text-sm font-semibold text-white mt-2">Réinitialiser le mot de passe</button>
            {{ form_end(resetForm) }}
        </div>
    </div>
</body>
</html>
{% endblock %}
