{# Gabarit commun de l'espace « Mon compte ». Blocs : title, head_assets, page_head (facultatif), body. #}
{% set route = app.request.attributes.get('_route') ?? '' %}
<!DOCTYPE html>
<html lang="fr" {% if app.user and app.user.theme != 'system' %}data-theme="{{ app.user.theme }}"{% endif %} data-scheme="{{ app.user ? app.user.colorScheme : 'rouge' }}" data-density="{{ app.user ? app.user.density : 'comfortable' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <title>{% block title %}Mon compte{% endblock %} — ES Coutances</title>
    {% block head_assets %}{% endblock %}
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles/mon-compte.css') }}">
</head>
<body>
    <header class="mc-top">
        <div class="mc-top-in">
            <a class="mc-brand" href="{{ path('portail_index') }}">
                <img src="https://raw.githubusercontent.com/CylaosICT/escoutances-images/refs/heads/main/logo_hd_trans3_gt.png" alt="ES Coutances">
                <span>Mon compte<small>ES Coutances</small></span>
            </a>
            <nav class="mc-nav" aria-label="Navigation du compte">
                <a href="{{ path('portail_index') }}" class="{{ route in ['portail_index', 'portail_licencie'] ? 'is-active' }}"><i class="fa-solid fa-house"></i> Accueil</a>
                {% if not portail_est_boutique() %}
                    <a href="{{ path('portail_planning') }}" class="{{ route starts with 'portail_planning' ? 'is-active' }}"><i class="fa-regular fa-calendar"></i> Planning</a>
                    {% if portail_facturation() %}<a href="{{ path('portail_factures') }}" class="{{ route starts with 'portail_factures' ? 'is-active' }}"><i class="fa-solid fa-file-invoice"></i> Factures</a>{% endif %}
                    <a href="{{ path('portail_chat_index') }}" class="{{ route starts with 'portail_chat' ? 'is-active' }}"><i class="fa-regular fa-comments"></i> Messagerie{% set unread = chat_unread() %}<span class="pastille" data-chat-badge {{ unread == 0 ? 'hidden' }}>{{ unread }}</span></a>
                {% endif %}
                {% if portail_est_boutique() %}
                    <a href="{{ path('portail_chat_index') }}" class="{{ route starts with 'portail_chat' ? 'is-active' }}"><i class="fa-solid fa-headset"></i> Support{% set unread = chat_unread() %}<span class="pastille" data-chat-badge {{ unread == 0 ? 'hidden' }}>{{ unread }}</span></a>
                {% endif %}
                {% if portail_commandes_visible() %}<a href="{{ path('portail_commandes') }}" class="{{ route starts with 'portail_commandes' ? 'is-active' }}"><i class="fa-solid fa-bag-shopping"></i> Commandes</a>{% endif %}
                <a href="{{ path('boutique_index') }}"><i class="fa-solid fa-store"></i> Boutique</a>
            </nav>
            <div class="mc-user">
                <a class="mc-user-link" href="{{ path('portail_parametres_profil') }}" title="Paramètres du compte">
                    <span class="mc-avatar" aria-hidden="true">{% if app.user.avatarName %}<img src="{{ asset('uploads/avatars/' ~ app.user.avatarName) }}" alt="">{% else %}{{ app.user.initiale }}{% endif %}</span>
                    <span class="mc-user-name">{{ app.user.nomComplet ?: app.user.email }}</span>
                </a>
                <a class="mc-logout" href="{{ path('portail_logout') }}" title="Se déconnecter" aria-label="Se déconnecter"><i class="fa-solid fa-right-from-bracket"></i></a>
            </div>
        </div>
    </header>
    <main class="mc-main">
        {% block page_head %}{% endblock %}
        {% block body %}{% endblock %}
    </main>
    {% include 'chat/_badge_poller.html.twig' with {url: path('portail_chat_unread')} only %}
</body>
</html>
