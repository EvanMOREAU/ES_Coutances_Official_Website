{% extends 'portail/_auth.html.twig' %}

{% block title %}Compte supprimé{% endblock %}
{% block heading %}Compte supprimé{% endblock %}
{% block lead %}Vos données personnelles ont été effacées.{% endblock %}

{% block card %}
    <p class="u-082edb16 mc-note">{{ 'Votre compte a été supprimé et vos informations personnelles ont été anonymisées. Seules les factures sont conservées par le club, sans lien avec votre identité.'|trans }}</p>
    <p class="mc-note">{{ 'Un e-mail de confirmation vous a été envoyé. Merci d\'avoir fait partie de l\'ES Coutances.'|trans }}</p>
    <a class="u-f7dbba7a bouton" href="{{ path('app_home') }}">{{ 'Retour au site'|trans }}</a>
{% endblock %}
