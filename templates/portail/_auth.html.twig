{# Gabarit des pages d'authentification du compte (connexion, inscription). Blocs : title, heading, lead, card. #}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}" dir="{{ locale_dir(app.request ? app.request.locale : 'fr') }}" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="csp-nonce" content="{{ csp_nonce() }}">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <link rel="stylesheet" href="{{ asset('styles/inline-utilities.css') }}">
    <title>{% block title %}{{ 'nav.account'|trans }}{% endblock %} — ES Coutances</title>
    <link rel="stylesheet" href="{{ asset('fonts/fonts.css') }}">
    <link rel="stylesheet" href="{{ asset('vendor/fontawesome/all.min.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/mon-compte.css') }}">
    {% block head_assets %}{% endblock %}
</head>
<body>
    <div class="mc-auth">
        <div class="mc-auth-box">
            <div class="mc-auth-brand">
                <a href="{{ path('app_home') }}"><img src="{{ asset('images/logo_hd_trans3_gt.png') }}" alt="{{ 'ES Coutances'|trans }}"></a>
                <h1>{% block heading %}{{ 'nav.account'|trans }}{% endblock %}</h1>
                <p class="mc-sub">{% block lead %}{% endblock %}</p>
            </div>
            <div class="mc-auth-card">
                {% block card %}{% endblock %}
            </div>
            <div class="mc-auth-links">
                <a href="{{ path('app_home') }}"><i class="fa-solid fa-arrow-left"></i> {{ 'Retour au site'|trans }}</a>
            </div>
            {{ include('_locale_switcher.html.twig') }}
        </div>
    </div>
</body>
</html>
