{% extends 'portail/_auth.html.twig' %}

{% block title %}Connexion{% endblock %}
{% block heading %}Connexion{% endblock %}
{% block lead %}Accédez à votre compte pour commander à la boutique et suivre vos commandes.{% endblock %}

{% block head_assets %}{{ include('_importmap.html.twig', {entry: 'portail'}) }}{% endblock %}

{% block card %}
    {% for message in app.flashes('success') %}
        <div class="mc-alert ok">{{ message }}</div>
    {% endfor %}
    {% if error %}
        <div class="mc-alert ko">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form method="post">
        <div class="mc-field">
            <label for="email">Adresse e-mail</label>
            <input type="email" id="email" name="email" value="{{ last_username }}" autocomplete="email" required autofocus>
        </div>
        <div class="mc-field">
            <label for="password">Mot de passe</label>
            <input type="password" id="password" name="password" autocomplete="current-password" required>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit" class="mc-submit">Se connecter</button>
    </form>

    <div style="margin-top:18px; padding-top:18px; border-top:1px solid var(--mc-border);" data-controller="passkey"
         data-passkey-options-url-value="{{ path('portail_webauthn_login_options') }}"
         data-passkey-finish-url-value="{{ path('portail_webauthn_login_check') }}">
        <button type="button" data-passkey-target="button" data-action="click->passkey#login" class="mc-btn" style="width:100%; justify-content:center;">
            <i class="fa-solid fa-fingerprint"></i> Se connecter avec une clé d'accès
        </button>
        <p class="mc-err" data-passkey-target="status" style="text-align:center;"></p>
    </div>

    <div class="mc-auth-links">
        <a href="{{ path('app_forgot_password_request') }}">Mot de passe oublié ?</a>
        <a href="{{ path('portail_inscription') }}">Pas encore de compte ? <strong>Créer un compte</strong></a>
    </div>
{% endblock %}
