{% extends 'portail/parametres/_layout.html.twig' %}

{% block tab_content %}
    {% set has_bell = false %}
    {% for key, section in sections %}{% if 'bell' in section.channels %}{% set has_bell = true %}{% endif %}{% endfor %}

    <section class="card">
        <form method="post" action="{{ path('portail_parametres_preferences') }}" data-controller="notif-prefs">
            <h2 class="mc-h2">{{ 'notif.page.title'|trans }}</h2>
            <p class="mc-lead">{{ (has_bell ? 'notif.page.lead_portal_bell' : 'notif.page.lead_portal')|trans }}</p>

            {% if sections is empty %}
                <div class="mc-empty"><i class="fa-regular fa-bell-slash"></i>{{ 'notif.page.empty'|trans }}</div>
            {% else %}
                <div class="mc-actions">
                    <button type="button" class="mc-btn" data-action="notif-prefs#enableAll"><i class="fa-solid fa-toggle-on"></i> {{ 'notif.page.all_on'|trans }}</button>
                    <button type="button" class="mc-btn" data-action="notif-prefs#disableAll"><i class="fa-solid fa-toggle-off"></i> {{ 'notif.page.all_off'|trans }}</button>
                </div>
                <div class="mc-head-cols">
                    {% if has_bell %}<span>{{ 'notif.page.bell'|trans }}</span>{% endif %}
                    <span>{{ 'notif.page.email'|trans }}</span>
                </div>
                {% for key, section in sections %}
                    <div class="mc-row">
                        <div>
                            <strong>{{ section.label }}</strong>
                            <small>{{ section.help }}</small>
                        </div>
                        <div class="mc-toggles">
                            {% if has_bell %}
                                {% if 'bell' in section.channels %}
                                    <input type="checkbox" class="mc-switch" name="prefs[bell][{{ key }}]" value="1" data-notif-prefs-target="switch" {{ prefs.wants(app.user, key, 'bell') ? 'checked' }} aria-label="{{ 'notif.page.bell_aria'|trans({'%label%': section.label}) }}">
                                {% else %}<span class="mc-dash">—</span>{% endif %}
                            {% endif %}
                            {% if 'email' in section.channels %}
                                <input type="checkbox" class="mc-switch" name="prefs[email][{{ key }}]" value="1" data-notif-prefs-target="switch" {{ prefs.wants(app.user, key, 'email') ? 'checked' }} aria-label="{{ 'notif.page.email_aria'|trans({'%label%': section.label}) }}">
                            {% else %}<span class="mc-dash">—</span>{% endif %}
                        </div>
                    </div>
                {% endfor %}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('account_notification_prefs') }}">
                <div class="mc-actions"><button type="submit" class="mc-btn is-primary">{{ 'settings.save'|trans }}</button></div>
            {% endif %}
            <p class="u-a855df37 mc-lead"><i class="fa-solid fa-circle-info"></i> {{ 'notif.page.always_portal'|trans }}</p>
        </form>
        <form method="post" action="{{ path('portail_parametres_preferences_test') }}">
            <p class="mc-lead">{{ 'notif.page.test_help'|trans({'%email%': app.user.email}) }}</p>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('account_notification_test') }}">
            <div class="mc-actions"><button type="submit" class="mc-btn"><i class="fa-regular fa-paper-plane"></i> {{ 'notif.page.test'|trans }}</button></div>
        </form>
    </section>
{% endblock %}
