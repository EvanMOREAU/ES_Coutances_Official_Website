{% extends 'portail/parametres/_layout.html.twig' %}

{% block tab_content %}
    {% set theme_icons = { light: 'fa-sun', dark: 'fa-moon', system: 'fa-display' } %}
    {% set density_icons = { compact: 'fa-bars', comfortable: 'fa-table-cells-large', spacious: 'fa-expand' } %}
    {% set scheme_colors = { rouge: '#C8102E', violet: '#7c3aed', blue: '#2563eb', emerald: '#059669', rose: '#e11d48', orange: '#ea580c', slate: '#64748b' } %}

    <section class="card">
        {{ form_start(form, {attr: {'data-controller': 'appearance', novalidate: 'novalidate'}}) }}
            <h2 class="mc-h2">Apparence</h2>
            <p class="mc-lead">Personnalisez l'affichage de votre espace : l'aperçu est immédiat, pensez à enregistrer.</p>

            <h3 class="mc-h3">Thème</h3>
            <div class="mc-choices c3">
                {% for child in form.theme %}
                    <label class="mc-choice">
                        {{ form_widget(child, {attr: {class: 'sr-only', 'data-action': 'change->appearance#apply'}}) }}
                        <i class="fa-solid {{ theme_icons[child.vars.value] }}"></i>
                        <span>{{ child.vars.label }}</span>
                    </label>
                {% endfor %}
            </div>

            <h3 class="mc-h3">Couleur d'accent</h3>
            <div class="mc-choices c7">
                {% for child in form.colorScheme %}
                    <label class="mc-choice">
                        {{ form_widget(child, {attr: {class: 'sr-only', 'data-action': 'change->appearance#apply'}}) }}
                        <span class="mc-swatch" style="background-color: {{ scheme_colors[child.vars.value] }};"></span>
                        <span>{{ child.vars.label }}</span>
                    </label>
                {% endfor %}
            </div>

            <h3 class="mc-h3">Densité</h3>
            <div class="mc-choices c3">
                {% for child in form.density %}
                    <label class="mc-choice">
                        {{ form_widget(child, {attr: {class: 'sr-only', 'data-action': 'change->appearance#apply'}}) }}
                        <i class="fa-solid {{ density_icons[child.vars.value] }}"></i>
                        <span>{{ child.vars.label }}</span>
                    </label>
                {% endfor %}
            </div>

            <h3 class="mc-h3">Langue</h3>
            <div class="mc-choices c3" style="margin-bottom: 8px;">
                <div class="mc-choice" style="border-color: var(--mc-red); background: var(--mc-red-soft);"><i class="fa-solid fa-globe" style="color: var(--mc-red);"></i><span>Français</span></div>
                <div class="mc-choice is-off"><i class="fa-solid fa-globe"></i><span>English</span></div>
                <div class="mc-choice is-off"><i class="fa-solid fa-globe"></i><span>Deutsch</span></div>
            </div>
            <p class="mc-lead">Seul le français est disponible pour le moment.</p>

            <div class="mc-actions"><button type="submit" class="mc-btn is-primary">Enregistrer</button></div>
        {{ form_end(form) }}
    </section>
{% endblock %}
