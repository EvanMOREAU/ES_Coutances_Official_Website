{% extends 'portail/parametres/_layout.html.twig' %}

{% block tab_content %}
    {% set theme_icons = { light: 'fa-sun', dark: 'fa-moon', system: 'fa-display' } %}
    {% set density_icons = { compact: 'fa-bars', comfortable: 'fa-table-cells-large', spacious: 'fa-expand' } %}
    {% set scheme_colors = { rouge: '#C8102E', violet: '#7c3aed', blue: '#2563eb', emerald: '#059669', rose: '#e11d48', orange: '#ea580c', slate: '#64748b' } %}

    <section class="card">
        {{ form_start(form, {attr: {'data-controller': 'appearance', novalidate: 'novalidate'}}) }}
            <h2 class="mc-h2">{{ 'settings.appearance.title'|trans }}</h2>
            <p class="mc-lead">{{ 'settings.appearance.lead_portal'|trans }}</p>

            <h3 class="mc-h3">{{ 'settings.appearance.theme'|trans }}</h3>
            <div class="mc-choices c3">
                {% for child in form.theme %}
                    <label class="mc-choice">
                        {{ form_widget(child, {attr: {class: 'sr-only', 'data-action': 'change->appearance#apply'}}) }}
                        <i class="fa-solid {{ theme_icons[child.vars.value] }}"></i>
                        <span>{{ child.vars.label }}</span>
                    </label>
                {% endfor %}
            </div>

            <h3 class="mc-h3">{{ 'settings.appearance.accent'|trans }}</h3>
            <div class="mc-choices c7">
                {% for child in form.colorScheme %}
                    <label class="mc-choice">
                        {{ form_widget(child, {attr: {class: 'sr-only', 'data-action': 'change->appearance#apply'}}) }}
                        <span class="mc-swatch scheme-{{ child.vars.value }}"></span>
                        <span>{{ child.vars.label }}</span>
                    </label>
                {% endfor %}
            </div>

            <h3 class="mc-h3">{{ 'settings.appearance.density'|trans }}</h3>
            <div class="mc-choices c3">
                {% for child in form.density %}
                    <label class="mc-choice">
                        {{ form_widget(child, {attr: {class: 'sr-only', 'data-action': 'change->appearance#apply'}}) }}
                        <i class="fa-solid {{ density_icons[child.vars.value] }}"></i>
                        <span>{{ child.vars.label }}</span>
                    </label>
                {% endfor %}
            </div>

            <h3 class="mc-h3">{{ 'settings.appearance.language'|trans }}</h3>
            <div class="mc-choices c3">
                {% for child in form.locale %}
                    <label class="mc-choice">
                        {{ form_widget(child, {attr: {class: 'sr-only'}}) }}
                        <i class="fa-solid fa-globe"></i>
                        <span>{{ child.vars.label }}</span>
                    </label>
                {% endfor %}
            </div>
            <p class="mc-lead">{{ 'settings.appearance.language_help'|trans }}</p>

            <div class="mc-actions"><button type="submit" class="mc-btn is-primary">{{ 'settings.save'|trans }}</button></div>
        {{ form_end(form) }}
    </section>
{% endblock %}
