{% macro render(value, level) %}
    {% if value is iterable %}
        {% if value is empty %}
            <em>—</em>
        {% elseif value|keys|first is same as(0) %}
            {# liste d'éléments #}
            {% for item in value %}
                <div class="item">{{ _self.render(item, level + 1) }}</div>
            {% endfor %}
        {% else %}
            <table>
                {% for key, item in value %}
                    <tr>
                        <th>{{ key }}</th>
                        <td>{{ _self.render(item, level + 1) }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}
    {% else %}
        {{ value|nl2br }}
    {% endif %}
{% endmacro %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Mes données — ES Coutances</title>
    <style>
        body { font-family: Arial, Helvetica, sans-serif; color: #18181b; max-width: 860px; margin: 32px auto; padding: 0 20px; line-height: 1.5; font-size: 14px; }
        h1 { color: #C8102E; font-size: 24px; margin-bottom: 4px; }
        h2 { font-size: 17px; margin: 32px 0 10px; padding-bottom: 6px; border-bottom: 2px solid #C8102E; }
        .meta { color: #71717a; font-size: 13px; }
        table { width: 100%; border-collapse: collapse; margin: 4px 0; }
        th, td { text-align: left; vertical-align: top; padding: 6px 10px; border-bottom: 1px solid #e4e4e7; }
        th { width: 32%; color: #52525b; font-weight: 600; }
        .item { margin: 10px 0 14px; padding: 8px 12px; border: 1px solid #e4e4e7; border-radius: 8px; }
        .item table table { margin: 0; }
        @media print { body { margin: 0; } .item { break-inside: avoid; } }
    </style>
</head>
<body>
    <h1>Récapitulatif de mes données</h1>
    <p class="meta">ES Coutances — document généré pour {{ user.nomComplet ?: user.email }}, conformément au droit d'accès (RGPD).</p>
    {% for section, content in data %}
        {% if section == 'Généré le' %}
            <p class="meta">Généré le {{ content }}</p>
        {% else %}
            <h2>{{ section }}</h2>
            {{ _self.render(content, 0) }}
        {% endif %}
    {% endfor %}
</body>
</html>
