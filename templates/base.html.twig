          {# Actualités désactivé : fonctionnalité non utilisée pour le moment
          <li><a href="#">Actualités</a></li>
          #}
          <li><a href="{{ match_live and match_live.url ? match_live.url : '#' }}"{{ match_live and match_live.url ? ' target="_blank" rel="noopener"' : '' }}>Match en Live</a></li>
