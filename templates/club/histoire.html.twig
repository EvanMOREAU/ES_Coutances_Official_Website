{% extends 'club/_layout.html.twig' %}

{% block title %}{{ page.titre|auto_trans }} — ES Coutances{% endblock %}

{% block body %}

{# Hero #}
<section class="page-hero">
  <div class="container page-hero-inner">
    <div class="breadcrumb">
      <a href="{{ path('app_home') }}">Accueil</a>
      <i class="fa-solid fa-chevron-right"></i>
      <span>{{ 'Le club'|trans }}</span>
      <i class="fa-solid fa-chevron-right"></i>
      <span>{{ page.titre|auto_trans }}</span>
    </div>
    <h1>{{ 'Un club,'|trans }}<br><span>{{ 'une histoire'|trans }}</span></h1>
  </div>
</section>

{# Contenu #}
<section class="page-content">
  <div class="container">
    {% if page.imageName %}
      <img class="page-content-image" src="{{ ('uploads/pages/' ~ page.imageName)|thumb('detail') }}" alt="{{ page.titre|auto_trans }}">
    {% endif %}
    {% if page.chapo %}
      <p class="page-content-chapo">{{ page.chapo|auto_trans }}</p>
    {% endif %}
    <div class="prose">
      {{ page.contenu|auto_trans|safe_html }}
    </div>
  </div>
</section>

{% endblock %}
