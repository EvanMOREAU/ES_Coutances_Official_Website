<div class="dropdown">

  {# Colonne 1 : Équipe première #}
  {% if equipes_by_categorie['premiere'] is defined %}
  <div class="dd-col wide">
    <h4>Équipe première</h4>
    {% for equipe in equipes_by_categorie['premiere'] %}
      <a href="{{ equipe.lienFff is not empty ? equipe.lienFff : '#' }}">{{ equipe.nom }}</a>
    {% endfor %}
  </div>
  {% endif %}

  {# Colonne 2 : Seniors + Formation empilés #}
  {% if equipes_by_categorie['seniors'] is defined or equipes_by_categorie['formation'] is defined %}
  <div class="dd-col">
    {% if equipes_by_categorie['seniors'] is defined %}
      <h4>Seniors</h4>
      {% for equipe in equipes_by_categorie['seniors'] %}
        <a href="{{ equipe.lienFff is not empty ? equipe.lienFff : '#' }}">{{ equipe.nom }}</a>
      {% endfor %}
    {% endif %}

    {% if equipes_by_categorie['formation'] is defined %}
      <h4 style="margin-top:16px">Formation</h4>
      {% for equipe in equipes_by_categorie['formation'] %}
        <a href="{{ equipe.lienFff is not empty ? equipe.lienFff : '#' }}">{{ equipe.nom }}</a>
      {% endfor %}
    {% endif %}
  </div>
  {% endif %}

  {# Colonne 3 : Académie + Féminines empilés #}
  {% if equipes_by_categorie['academie'] is defined or equipes_by_categorie['feminines'] is defined %}
  <div class="dd-col">
    {% if equipes_by_categorie['academie'] is defined %}
      <h4>Académie</h4>
      {% for equipe in equipes_by_categorie['academie'] %}
        <a href="{{ equipe.lienFff is not empty ? equipe.lienFff : '#' }}">{{ equipe.nom }}</a>
      {% endfor %}
    {% endif %}

    {% if equipes_by_categorie['feminines'] is defined %}
      <h4 style="margin-top:16px">Féminines</h4>
      {% for equipe in equipes_by_categorie['feminines'] %}
        <a href="{{ equipe.lienFff is not empty ? equipe.lienFff : '#' }}">{{ equipe.nom }}</a>
      {% endfor %}
    {% endif %}
  </div>
  {% endif %}

</div>