{% set ordre_categories = ['premiere', 'seniors', 'formation', 'academie', 'feminines'] %}

{% set labels = {
  'premiere':  'Équipe première',
  'seniors':   'Seniors',
  'formation': 'Formation',
  'academie':  'Académie',
  'feminines': 'Féminines'
} %}

{% for categorie in ordre_categories %}
  {% if equipes_by_categorie[categorie] is defined %}
    <h5>{{ labels[categorie] }}</h5>
    {% for equipe in equipes_by_categorie[categorie] %}
      <a target="_blank" href="{{ equipe.lienFff is not empty ? equipe.lienFff : '#' }}">
        {{ equipe.nom }}
      </a>
    {% endfor %}
  {% endif %}
{% endfor %}