{% extends 'admin/parametres/_layout.html.twig' %}

{% block tab_content %}
    {% set theme_icons = { light: 'fa-sun', dark: 'fa-moon', system: 'fa-display' } %}
    {% set density_icons = { compact: 'fa-bars', comfortable: 'fa-table-cells-large', spacious: 'fa-expand' } %}
    {% set scheme_colors = { rouge: '#C8102E', violet: '#7c3aed', blue: '#2563eb', emerald: '#059669', rose: '#e11d48', orange: '#ea580c', slate: '#64748b' } %}

    {{ form_start(form, {attr: {'data-controller': 'appearance'}}) }}
        <h2 class="text-lg font-bold">{{ 'settings.appearance.title'|trans }}</h2>
        <p class="text-sm text-admin-text-muted mb-6">{{ 'settings.appearance.lead_admin'|trans }}</p>

        <h3 class="text-xs font-semibold uppercase tracking-wide text-admin-text-muted mb-3">{{ 'settings.appearance.theme'|trans }}</h3>
        <div class="grid grid-cols-3 gap-3 mb-8">
            {% for child in form.theme %}
                <label class="choice-card p-4">
                    {{ form_widget(child, {attr: {class: 'sr-only', 'data-action': 'change->appearance#apply'}}) }}
                    <i class="choice-card-icon fa-solid {{ theme_icons[child.vars.value] }} text-lg mb-2 block"></i>
                    <span class="text-sm">{{ child.vars.label }}</span>
                </label>
            {% endfor %}
        </div>

        <h3 class="text-xs font-semibold uppercase tracking-wide text-admin-text-muted mb-3">{{ 'settings.appearance.accent'|trans }}</h3>
        <div class="grid grid-cols-3 sm:grid-cols-6 gap-3 mb-8">
            {% for child in form.colorScheme %}
                <label class="choice-card p-3">
                    {{ form_widget(child, {attr: {class: 'sr-only', 'data-action': 'change->appearance#apply'}}) }}
                    <span class="block h-5 w-5 rounded-full mx-auto mb-2 scheme-{{ child.vars.value }}"></span>
                    <span class="text-xs">{{ child.vars.label }}</span>
                </label>
            {% endfor %}
        </div>

        <h3 class="text-xs font-semibold uppercase tracking-wide text-admin-text-muted mb-3">{{ 'settings.appearance.density'|trans }}</h3>
        <div class="grid grid-cols-3 gap-3 mb-8">
            {% for child in form.density %}
                <label class="choice-card p-4">
                    {{ form_widget(child, {attr: {class: 'sr-only', 'data-action': 'change->appearance#apply'}}) }}
                    <i class="choice-card-icon fa-solid {{ density_icons[child.vars.value] }} text-lg mb-2 block"></i>
                    <span class="text-sm">{{ child.vars.label }}</span>
                </label>
            {% endfor %}
        </div>

        <h3 class="text-xs font-semibold uppercase tracking-wide text-admin-text-muted mb-3">{{ 'settings.appearance.language'|trans }}</h3>
        <div class="grid grid-cols-3 gap-3 mb-2">
            {% for child in form.locale %}
                <label class="choice-card p-4">
                    {{ form_widget(child, {attr: {class: 'sr-only'}}) }}
                    <i class="choice-card-icon fa-solid fa-globe text-lg mb-2 block"></i>
                    <span class="text-sm">{{ child.vars.label }}</span>
                </label>
            {% endfor %}
        </div>
        <p class="text-xs text-admin-text-muted mb-8">{{ 'settings.appearance.language_help'|trans }}</p>

        <div class="flex justify-end">
            <button type="submit" class="rounded-lg admin-gradient px-5 py-2 text-sm font-semibold text-white">{{ 'settings.save'|trans }}</button>
        </div>
    {{ form_end(form) }}
{% endblock %}
