{% extends 'admin/parametres/_layout.html.twig' %}

{% block tab_content %}
    {% set has_bell = false %}
    {% for key, section in sections %}{% if 'bell' in section.channels %}{% set has_bell = true %}{% endif %}{% endfor %}

    <form method="post" action="{{ path('admin_parametres_preferences') }}">
        <h2 class="text-lg font-bold">Notifications</h2>
        <p class="text-sm text-admin-text-muted mb-4">Choisissez ce dont vous voulez être averti, dans la clochette de l'administration et par e-mail. Tout est activé par défaut ; seules les rubriques auxquelles vos autorisations donnent accès sont proposées.</p>

        {% if sections is empty %}
            <p class="text-sm text-admin-text-muted py-6 text-center">Aucune notification à régler pour ce compte.</p>
        {% else %}
            <div class="flex justify-end gap-3 text-[11px] font-semibold uppercase tracking-wide text-admin-text-muted">
                {% if has_bell %}<span class="w-14 text-center">Cloche</span>{% endif %}
                <span class="w-14 text-center">E-mail</span>
            </div>
            <div class="divide-y divide-admin-border">
                {% for key, section in sections %}
                    <div class="flex items-center justify-between gap-6 py-4">
                        <span>
                            <span class="block text-sm font-semibold">{{ section.label }}</span>
                            <span class="block text-xs text-admin-text-muted mt-0.5">{{ section.help }}</span>
                        </span>
                        <span class="flex gap-3 shrink-0">
                            {% if has_bell %}
                                <span class="w-14 flex justify-center">
                                    {% if 'bell' in section.channels %}
                                        <input type="checkbox" class="admin-switch" name="prefs[bell][{{ key }}]" value="1" {{ prefs.wants(app.user, key, 'bell') ? 'checked' }} aria-label="{{ section.label }} — cloche">
                                    {% else %}<span class="text-admin-text-muted">—</span>{% endif %}
                                </span>
                            {% endif %}
                            <span class="w-14 flex justify-center">
                                {% if 'email' in section.channels %}
                                    <input type="checkbox" class="admin-switch" name="prefs[email][{{ key }}]" value="1" {{ prefs.wants(app.user, key, 'email') ? 'checked' }} aria-label="{{ section.label }} — e-mail">
                                {% else %}<span class="text-admin-text-muted">—</span>{% endif %}
                            </span>
                        </span>
                    </div>
                {% endfor %}
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('account_notification_prefs') }}">
        {% endif %}

        <div class="flex items-center justify-between mt-4">
            <p class="text-xs text-admin-text-muted">Les e-mails de sécurité (code de connexion, mot de passe) sont toujours envoyés.</p>
            {% if sections is not empty %}<button type="submit" class="rounded-lg admin-gradient px-5 py-2 text-sm font-semibold text-white shrink-0 ml-4">Enregistrer</button>{% endif %}
        </div>
    </form>
{% endblock %}
