{% extends 'admin/_layout.html.twig' %}
{% if form is defined %}{% form_theme form 'admin/_form_theme.html.twig' %}{% endif %}

{% block title %}{{ 'settings.title'|trans }}{% endblock %}

{% block body %}
    <h1 class="u-66972700 text-2xl font-black">{{ 'settings.title'|trans }}</h1>
    <p class="text-sm text-admin-text-muted mb-6">{{ 'settings.lead_admin'|trans }}</p>

    {% set tabs = [
        { id: 'profil', label: 'settings.tab.profile'|trans, desc: 'settings.tab.profile_desc'|trans, icon: 'fa-user', route: 'admin_parametres_profil' },
        { id: 'securite', label: 'settings.tab.security'|trans, desc: 'settings.tab.security_desc_admin'|trans, icon: 'fa-shield-halved', route: 'admin_parametres_securite' },
        { id: 'preferences', label: 'settings.tab.notifications'|trans, desc: 'settings.tab.notifications_desc_admin'|trans, icon: 'fa-bell', route: 'admin_parametres_preferences' },
        { id: 'apparence', label: 'settings.tab.appearance'|trans, desc: 'settings.tab.appearance_desc'|trans, icon: 'fa-palette', route: 'admin_parametres_apparence' },
    ] %}

    <div class="grid gap-6 lg:grid-cols-[15rem_minmax(0,1fr)] items-start">
        <nav class="flex lg:flex-col gap-2 overflow-x-auto lg:overflow-visible">
            {% for tab in tabs %}
                {% set active = active_tab == tab.id %}
                <a href="{{ path(tab.route) }}"
                   class="flex items-center gap-3 rounded-xl px-4 py-3 min-w-max lg:min-w-0 {{ active ? 'admin-surface-active' : 'text-admin-text-muted admin-surface-hover' }}">
                    <i class="fa-solid {{ tab.icon }} w-4 text-center {{ active ? 'text-admin-primary-to' : '' }}"></i>
                    <span>
                        <span class="block text-sm font-semibold {{ active ? 'text-admin-primary-to' : '' }}">{{ tab.label }}</span>
                        <span class="block text-xs text-admin-text-muted">{{ tab.desc }}</span>
                    </span>
                </a>
            {% endfor %}
        </nav>

        <div class="admin-card rounded-2xl p-6 sm:p-8 max-w-3xl min-w-0">
            {% block tab_content %}{% endblock %}
        </div>
    </div>
{% endblock %}
