{% extends 'admin/_layout.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}

{% block title %}Paramètres{% endblock %}

{% block body %}
    <h1 class="text-2xl font-black" style="font-family:'Barlow Condensed',sans-serif;">Paramètres</h1>
    <p class="text-sm text-admin-text-muted mb-6">Gérez votre compte et personnalisez l'application.</p>

    {% set tabs = [
        { id: 'profil', label: 'Profil', desc: 'Informations personnelles', icon: 'fa-user', route: 'admin_parametres_profil' },
        { id: 'preferences', label: 'Préférences', desc: 'Notifications et alertes', icon: 'fa-bell', route: 'admin_parametres_preferences' },
        { id: 'apparence', label: 'Apparence', desc: 'Thème et affichage', icon: 'fa-palette', route: 'admin_parametres_apparence' },
    ] %}

    <div class="grid gap-6 lg:grid-cols-[15rem_minmax(0,1fr)] items-start">
        <nav class="flex lg:flex-col gap-2 overflow-x-auto">
            {% for tab in tabs %}
                {% set active = active_tab == tab.id %}
                <a href="{{ path(tab.route) }}"
                   class="flex items-center gap-3 rounded-xl px-4 py-3 min-w-max {{ active ? 'admin-surface-active' : 'text-admin-text-muted admin-surface-hover' }}">
                    <i class="fa-solid {{ tab.icon }} w-4 text-center {{ active ? 'text-admin-primary-to' : '' }}"></i>
                    <span>
                        <span class="block text-sm font-semibold {{ active ? 'text-admin-primary-to' : '' }}">{{ tab.label }}</span>
                        <span class="block text-xs text-admin-text-muted">{{ tab.desc }}</span>
                    </span>
                </a>
            {% endfor %}
        </nav>

        <div class="admin-card rounded-2xl p-6 sm:p-8 max-w-3xl">
            {% block tab_content %}{% endblock %}
        </div>
    </div>
{% endblock %}
