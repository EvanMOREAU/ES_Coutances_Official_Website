{% extends 'admin/_layout.html.twig' %}
{% import _self as ui %}

{% block title %}{{ 'admin.nav.dashboard'|trans }}{% endblock %}

{% block body %}
    {% set sections = available|map(w => w.section)|reduce((carry, name) => carry|merge({(name): true}), {}) %}
    {% set paiements = data.paiements ?? null %}

    <div data-controller="dashboard"
         data-dashboard-hidden-value="{{ hidden|json_encode|e('html_attr') }}"
         data-dashboard-prefs-url-value="{{ path('admin_table_preferences', {key: 'dashboard'}) }}"
         data-dashboard-prefs-token-value="{{ csrf_token('admin-table-preferences') }}">

    <div class="admin-hero relative overflow-hidden rounded-2xl p-8 mb-8">
        <div class="admin-hero-glow"></div>
        <div class="relative">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h1 class="u-66972700 text-3xl font-black text-white">
                        {{ 'dashboard.hello'|trans({'%name%': app.user ? app.user.nomComplet : ''}) }}
                    </h1>
                    <p class="text-white/75 mt-1">{{ 'dashboard.lead'|trans }}</p>
                </div>
                <div data-controller="menu" class="relative shrink-0">
                    <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" data-menu-target="button" data-action="click->menu#toggle" aria-haspopup="true" aria-expanded="false">
                        <i class="fa-solid fa-sliders"></i> {{ 'dashboard.customize'|trans }}
                    </button>
                    <div data-menu-target="panel" class="admin-menu-panel hidden">
                        <p class="admin-menu-title">{{ 'dashboard.shown_modules'|trans }}</p>
                        {% for key, widget in available %}
                            <label class="admin-menu-item admin-menu-check">
                                <input type="checkbox" {{ key in hidden ? '' : 'checked' }} data-widget="{{ key }}"
                                       data-action="change->dashboard#toggle">
                                <span>{{ widget.label|trans }}</span>
                            </label>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="kpi-grid mt-7">
                {% for stat in stats %}
                    <a href="{{ path(stat.route) }}" class="kpi-tile">
                        <span class="kpi-label"><i class="fa-solid fa-{{ stat.icon }}"></i> {{ ('dashboard.kpi.' ~ stat.key)|trans }}</span>
                        <span class="kpi-value u-66972700">{{ stat.value }}</span>
                        {% if stat.trend %}
                            <span class="kpi-sub block {{ stat.trend.positive ? 'kpi-up' : 'kpi-down' }}">
                                <i class="fa-solid {{ stat.trend.positive ? 'fa-arrow-trend-up' : 'fa-arrow-trend-down' }}"></i>
                                <strong>{{ stat.trend.value }}</strong> <span class="text-white/60">{{ 'dashboard.kpi.vs'|trans({'%season%': stat.trend.previous}) }}</span>
                            </span>
                        {% endif %}
                    </a>
                {% endfor %}
                {% if paiements and paiements.saison %}
                    <a href="{{ path('admin_adhesion_index') }}" class="kpi-tile">
                        <span class="kpi-label"><i class="fa-solid fa-file-invoice-dollar"></i> {{ 'dashboard.kpi.to_collect'|trans }}</span>
                        <span class="kpi-value u-66972700">{{ paiements.remaining|money }}</span>
                        <span class="kpi-sub block">{{ 'dashboard.kpi.of_due'|trans({'%due%': paiements.due|money, '%season%': paiements.saison}) }}</span>
                    </a>
                {% endif %}
                {% if data.boutique is defined %}
                    <a href="{{ path('admin_commande_index') }}" class="kpi-tile">
                        <span class="kpi-label"><i class="fa-solid fa-bag-shopping"></i> {{ 'dashboard.kpi.shop_month'|trans }}</span>
                        <span class="kpi-value u-66972700">{{ data.boutique.monthRevenue|money }}</span>
                        <span class="kpi-sub block">{{ 'dashboard.kpi.orders_to_prepare'|trans({'%count%': commandes_a_preparer()}) }}</span>
                    </a>
                {% endif %}
            </div>
        </div>
    </div>

    {# Conseils de configuration : invitation (jamais obligatoire) à compléter le site #}
    {% if available.advice is defined %}
        {% set advice_vitrine = advice_items('vitrine') %}
        {% set advice_licencies = advice_items('licencies') %}
        <div data-dashboard-target="widget" data-widget="advice" {{ 'advice' in hidden ? 'hidden' }}>
            {% if advice_vitrine|length + advice_licencies|length > 0 %}
                <div class="admin-card rounded-2xl p-5 mb-6">
                    <div class="flex items-center gap-3 mb-3">
                        <span class="vt-advice-icon"><i class="fa-solid fa-lightbulb"></i></span>
                        <div>
                            <h2 class="font-bold">{{ 'dashboard.advice.title'|trans }}</h2>
                            <p class="text-xs text-admin-text-muted">{{ 'dashboard.advice.lead'|trans }}</p>
                        </div>
                    </div>
                    <ul class="u-57ce1f1b vt-advice-list">
                        {% for a in (advice_vitrine|map(a => a|merge({url: path('admin_site_vitrine', {ouvrir: a.section, vue: a.target})})))|merge(advice_licencies|map(a => a|merge({url: path('admin_licencies_hub', {ouvrir: a.section, vue: a.target})}))) %}
                            {% if loop.index <= 6 %}
                                <li>
                                    <a href="{{ a.url }}" class="vt-advice-item {{ a.optional ? 'is-optional' }}">
                                        <span class="vt-icon vt-icon-sm"><i class="fa-solid {{ a.icon }}"></i></span>
                                        <span class="vt-advice-text">
                                            <span class="vt-advice-label">{{ a.label }}</span>
                                            <span class="vt-advice-detail">{{ a.detail }}</span>
                                        </span>
                                        <i class="fa-solid fa-arrow-right vt-advice-go"></i>
                                    </a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>
    {% endif %}

    {# ------------------------------------------------------------ Licenciés et familles #}
    {% if sections.members is defined %}
        <h2 class="dash-section">{{ 'dashboard.section.members'|trans }}</h2>
        <div class="grid lg:grid-cols-2 gap-6">
            {% if available.licencies_evolution is defined %}
                {% set first = licencies_evolution|first %}
                {% set last = licencies_evolution|last %}
                <div class="admin-card rounded-2xl p-6" data-dashboard-target="widget" data-widget="licencies_evolution" {{ 'licencies_evolution' in hidden ? 'hidden' }}>
                    <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
                        <div>
                            <h2 class="font-bold">{{ 'dashboard.widget.members_evolution'|trans }}</h2>
                            <p class="text-sm text-admin-text-muted">{{ 'dashboard.members_evolution.lead'|trans }}</p>
                        </div>
                        {% if last %}
                            <div class="ml-auto text-right">
                                <p class="u-66972700 text-2xl font-black">{{ last.total }}</p>
                                {% set gain = last.total - (first.total - first.new) %}
                                <p class="text-xs text-admin-text-muted">{{ 'dashboard.over_12_months'|trans({'%gain%': gain > 0 ? '+' ~ gain : gain}) }}</p>
                            </div>
                        {% endif %}
                    </div>
                    {{ ui.line('dashboard.widget.members_evolution'|trans, licencies_evolution, 'dashboard.unit.member') }}
                </div>
            {% endif %}

            {% if available.licencies_genre is defined and data.licencies_genre is defined %}
                {% set g = data.licencies_genre %}
                {{ ui.chart('licencies_genre', hidden, 'dashboard.widget.members_gender'|trans, 'dashboard.members_gender.lead'|trans,
                    'donut', ['dashboard.gender.female'|trans, 'dashboard.gender.male'|trans, 'dashboard.gender.unknown'|trans],
                    [{name: '', values: [g.female, g.male, g.unknown]}], {center: 'dashboard.unit.member_plural'|trans}) }}
            {% endif %}

            {% if available.effectifs_categories is defined and data.effectifs is defined %}
                {% set eff = data.effectifs %}
                {{ ui.chart('effectifs_categories', hidden, 'dashboard.widget.members_categories'|trans,
                    eff.saison ? 'dashboard.members_categories.lead'|trans({'%season%': eff.saison}) : 'dashboard.no_season'|trans,
                    'bar', eff.categories|map(c => c.categorie),
                    [{name: eff.saison ?: '', values: eff.categories|map(c => c.actuel)}, {name: 'dashboard.previous_season'|trans, values: eff.categories|map(c => c.precedent)}],
                    {wide: true, stats: [
                        {value: eff.total, label: 'dashboard.members_categories.total'|trans},
                        {value: eff.tauxReinscription is not null ? eff.tauxReinscription ~ ' %' : '—', label: 'dashboard.members_categories.retention'|trans},
                        {value: '+' ~ eff.nouveaux, label: 'dashboard.members_categories.new'|trans},
                        {value: eff.partants > 0 ? '−' ~ eff.partants : '0', label: 'dashboard.members_categories.left'|trans},
                    ]}) }}
            {% endif %}

            {% if available.licencies_saisons is defined and data.licencies_saisons is defined %}
                {{ ui.chart('licencies_saisons', hidden, 'dashboard.widget.members_seasons'|trans, 'dashboard.members_seasons.lead'|trans,
                    'bar', data.licencies_saisons|map(r => r.label), [{name: 'dashboard.unit.member_plural'|trans, values: data.licencies_saisons|map(r => r.value)}]) }}
            {% endif %}

            {% if available.licencies_equipes is defined and data.licencies_equipes is defined %}
                {{ ui.chart('licencies_equipes', hidden, 'dashboard.widget.members_teams'|trans, 'dashboard.members_teams.lead'|trans,
                    'hbar', data.licencies_equipes|map(r => r.label), [{name: 'dashboard.unit.member_plural'|trans, values: data.licencies_equipes|map(r => r.value)}]) }}
            {% endif %}

            {% if available.familles_evolution is defined and data.familles_evolution is defined %}
                {{ ui.chart('familles_evolution', hidden, 'dashboard.widget.families_evolution'|trans, 'dashboard.families_evolution.lead'|trans,
                    'bar', data.familles_evolution|map(p => p.month|date_fr('MMM')), [{name: 'dashboard.unit.family_plural'|trans, values: data.familles_evolution|map(p => p.value)}]) }}
            {% endif %}

            {% if available.familles_tailles is defined and data.familles_tailles is defined %}
                {% set t = data.familles_tailles %}
                {{ ui.chart('familles_tailles', hidden, 'dashboard.widget.families_sizes'|trans, 'dashboard.families_sizes.lead'|trans,
                    'donut', ['dashboard.families_sizes.none'|trans, 'dashboard.families_sizes.one'|trans, 'dashboard.families_sizes.two'|trans, 'dashboard.families_sizes.three'|trans],
                    [{name: '', values: [t.empty, t.one, t.two, t.three]}], {center: 'dashboard.unit.family_plural'|trans}) }}
            {% endif %}
        </div>
    {% endif %}

    {# ------------------------------------------------------------ Licences et paiements #}
    {% if sections.payments is defined and paiements %}
        <h2 class="dash-section">{{ 'dashboard.section.payments'|trans }}</h2>
        <div class="grid lg:grid-cols-2 gap-6">
            {% if available.paiements_encaisse is defined %}
                {{ ui.chart('paiements_encaisse', hidden, 'dashboard.widget.payments_collected'|trans,
                    paiements.saison ? 'dashboard.payments_collected.lead'|trans({'%season%': paiements.saison}) : 'dashboard.no_season'|trans,
                    'donut', ['dashboard.payments.received'|trans, 'dashboard.payments.aids'|trans, 'dashboard.payments.family_left'|trans],
                    [{name: '', values: [paiements.received, paiements.aids, max(0, paiements.remaining - paiements.aids)]}],
                    {format: 'money', center: 'dashboard.payments.due_caption'|trans,
                     stats: [{value: paiements.due|money, label: 'dashboard.payments.due_label'|trans}, {value: paiements.received|money, label: 'dashboard.payments.received'|trans}, {value: paiements.remaining|money, label: 'dashboard.payments.remaining'|trans}]}) }}
            {% endif %}

            {% if available.paiements_statuts is defined %}
                {% set st = paiements.statuses %}
                {{ ui.chart('paiements_statuts', hidden, 'dashboard.widget.payments_status'|trans,
                    paiements.saison ? 'dashboard.payments_status.lead'|trans({'%count%': paiements.count, '%season%': paiements.saison}) : 'dashboard.no_season'|trans,
                    'donut', ['dashboard.payment_status.paye'|trans, 'dashboard.payment_status.attente_aides'|trans, 'dashboard.payment_status.partiel'|trans, 'dashboard.payment_status.impaye'|trans],
                    [{name: '', values: [st.paye ?? 0, st.attente_aides ?? 0, st.partiel ?? 0, st.impaye ?? 0]}], {center: 'dashboard.payments_status.center'|trans}) }}
            {% endif %}

            {% if available.reglements_mois is defined and data.reglements_mois is defined %}
                {{ ui.chart('reglements_mois', hidden, 'dashboard.widget.payments_monthly'|trans, 'dashboard.payments_monthly.lead'|trans,
                    'bar', data.reglements_mois|map(p => p.month|date_fr('MMM')), [{name: 'dashboard.payments.collected'|trans, values: data.reglements_mois|map(p => p.value)}], {format: 'money'}) }}
            {% endif %}

            {% if available.reglements_modes is defined and data.reglements_modes is defined %}
                {% set modes = data.reglements_modes %}
                {{ ui.chart('reglements_modes', hidden, 'dashboard.widget.payments_methods'|trans, 'dashboard.payments_methods.lead'|trans,
                    'donut', ['dashboard.mode.cheque'|trans, 'dashboard.mode.especes'|trans, 'dashboard.mode.carte'|trans],
                    [{name: '', values: [modes.cheque ?? 0, modes.especes ?? 0, modes.carte ?? 0]}], {format: 'money'}) }}
            {% endif %}
        </div>
    {% endif %}

    {# ------------------------------------------------------------ Boutique #}
    {% if sections.shop is defined %}
        <h2 class="dash-section">{{ 'dashboard.section.shop'|trans }}</h2>
        <div class="grid lg:grid-cols-2 gap-6">
            {% if available.boutique_ventes is defined %}
                {% set vente_last = boutique_ventes|last %}
                <div class="admin-card rounded-2xl p-6" data-dashboard-target="widget" data-widget="boutique_ventes" {{ 'boutique_ventes' in hidden ? 'hidden' }}>
                    <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
                        <div>
                            <h2 class="font-bold">{{ 'dashboard.widget.shop_sales'|trans }}</h2>
                            <p class="text-sm text-admin-text-muted">{{ 'dashboard.shop_sales.lead'|trans }}</p>
                        </div>
                        <div class="ml-auto text-right">
                            <p class="u-66972700 text-2xl font-black">{{ (vente_last.total ?? 0)|number_format(0, ',', ' ') }}&nbsp;€</p>
                            <p class="text-xs text-admin-text-muted">{{ 'dashboard.shop_sales.this_month'|trans({'%amount%': (vente_last.new ?? 0)|number_format(0, ',', ' ')}) }}</p>
                        </div>
                    </div>
                    {{ ui.line('dashboard.widget.shop_sales'|trans, boutique_ventes, '€', '€') }}
                </div>
            {% endif %}

            {% if available.boutique_commandes is defined and data.boutique_commandes is defined %}
                {% set shop = data.boutique %}
                {{ ui.chart('boutique_commandes', hidden, 'dashboard.widget.shop_orders'|trans, 'dashboard.shop_orders.lead'|trans,
                    'bar', data.boutique_commandes|map(p => p.month|date_fr('MMM')), [{name: 'dashboard.unit.order_plural'|trans, values: data.boutique_commandes|map(p => p.value)}],
                    {stats: [{value: shop.paid, label: 'dashboard.shop.paid'|trans}, {value: shop.average|money, label: 'dashboard.shop.average'|trans}, {value: shop.pending, label: 'dashboard.shop.pending'|trans}]}) }}
            {% endif %}

            {% if available.boutique_statuts is defined and data.boutique_statuts is defined %}
                {% set cs = data.boutique_statuts %}
                {{ ui.chart('boutique_statuts', hidden, 'dashboard.widget.shop_status'|trans, 'dashboard.shop_status.lead'|trans,
                    'donut', ['dashboard.order_status.nouvelle'|trans, 'dashboard.order_status.prete'|trans, 'dashboard.order_status.retiree'|trans, 'dashboard.order_status.annulee'|trans],
                    [{name: '', values: [cs.nouvelle ?? 0, cs.prete ?? 0, cs.retiree ?? 0, cs.annulee ?? 0]}], {center: 'dashboard.unit.order_plural'|trans}) }}
            {% endif %}

            {% if available.boutique_top is defined and data.boutique_top is defined %}
                {{ ui.chart('boutique_top', hidden, 'dashboard.widget.shop_top'|trans, 'dashboard.shop_top.lead'|trans,
                    'hbar', data.boutique_top|map(r => r.label), [{name: 'dashboard.unit.sold'|trans, values: data.boutique_top|map(r => r.value)}]) }}
            {% endif %}
        </div>
    {% endif %}

    {# ------------------------------------------------------------ Partenaires #}
    {% if sections.partners is defined %}
        <h2 class="dash-section">{{ 'dashboard.section.partners'|trans }}</h2>
        <div class="grid lg:grid-cols-2 gap-6">
            {% if available.partenaires_evolution is defined %}
                {% set p_first = partenaires_evolution|first %}
                {% set p_last = partenaires_evolution|last %}
                <div class="admin-card rounded-2xl p-6" data-dashboard-target="widget" data-widget="partenaires_evolution" {{ 'partenaires_evolution' in hidden ? 'hidden' }}>
                    <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
                        <div>
                            <h2 class="font-bold">{{ 'dashboard.widget.partners_evolution'|trans }}</h2>
                            <p class="text-sm text-admin-text-muted">{{ 'dashboard.partners_evolution.lead'|trans }}</p>
                        </div>
                        {% if p_last %}
                            <div class="ml-auto text-right">
                                <p class="u-66972700 text-2xl font-black">{{ p_last.total }}</p>
                                {% set gain = p_last.total - (p_first.total - p_first.new) %}
                                <p class="text-xs text-admin-text-muted">{{ 'dashboard.over_12_months'|trans({'%gain%': gain > 0 ? '+' ~ gain : gain}) }}</p>
                            </div>
                        {% endif %}
                    </div>
                    {{ ui.line('dashboard.widget.partners_evolution'|trans, partenaires_evolution, 'dashboard.unit.partner') }}
                </div>
            {% endif %}

            {% if available.partenaires_categories is defined and data.partenaires_categories is defined %}
                {{ ui.chart('partenaires_categories', hidden, 'dashboard.widget.partners_categories'|trans, 'dashboard.partners_categories.lead'|trans,
                    'donut', data.partenaires_categories|map(r => r.label ?: 'dashboard.partners_categories.none'|trans),
                    [{name: '', values: data.partenaires_categories|map(r => r.value)}], {center: 'dashboard.unit.partner_plural'|trans}) }}
            {% endif %}

            {% if available.contrats_encaissement is defined and data.contrats is defined %}
                {% set ct = data.contrats %}
                {{ ui.chart('contrats_encaissement', hidden, 'dashboard.widget.contracts_collected'|trans, 'dashboard.contracts_collected.lead'|trans,
                    'donut', ['dashboard.contracts.received'|trans, 'dashboard.contracts.remaining'|trans], [{name: '', values: [ct.received, ct.remaining]}],
                    {format: 'money', center: 'dashboard.contracts.caption'|trans,
                     stats: [{value: ct.total|money, label: 'dashboard.contracts.total'|trans}, {value: ct.active, label: 'dashboard.contracts.active'|trans}]}) }}
            {% endif %}

            {% if available.contrats_taches is defined and data.taches is defined %}
                <div class="admin-card rounded-2xl p-6" data-dashboard-target="widget" data-widget="contrats_taches" {{ 'contrats_taches' in hidden ? 'hidden' }}>
                    <div class="flex items-center justify-between mb-2">
                        <h2 class="font-bold">{{ 'dashboard.widget.contracts_tasks'|trans }}</h2>
                        <a href="{{ path('admin_partenaire_index') }}" class="text-xs text-admin-text-muted hover:text-admin-text">{{ 'dashboard.see_all'|trans }} &rarr;</a>
                    </div>
                    <div class="dash-stat">
                        <div><p class="dash-stat-value">{{ data.taches.late }}</p><p class="dash-stat-label">{{ 'dashboard.tasks.late'|trans }}</p></div>
                        <div><p class="dash-stat-value">{{ data.taches.soon }}</p><p class="dash-stat-label">{{ 'dashboard.tasks.soon'|trans }}</p></div>
                    </div>
                    <div class="recent-list">
                        {% for tache in data.taches.next %}
                            <a href="{{ tache.contrat ? path('admin_partenaire_contrat_show', {id: tache.contrat.id}) : '#' }}" class="recent-item">
                                <span class="recent-title">{{ tache.titre }}</span>
                                <span class="recent-meta">{{ tache.contrat.partenaire.nom ?? '' }}{{ tache.echeance ? ' · ' ~ tache.echeance|date_fr('d MMM') }}</span>
                            </a>
                        {% else %}
                            <p class="text-sm text-admin-text-muted py-2">{{ 'dashboard.tasks.none'|trans }}</p>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>
    {% endif %}

    {# ------------------------------------------------------------ Planning #}
    {% if sections.planning is defined %}
        <h2 class="dash-section">{{ 'dashboard.section.planning'|trans }}</h2>
        <div class="grid lg:grid-cols-2 gap-6">
            {% if available.planning_prochains is defined and data.prochains is defined %}
                <div class="admin-card rounded-2xl p-6" data-dashboard-target="widget" data-widget="planning_prochains" {{ 'planning_prochains' in hidden ? 'hidden' }}>
                    <div class="flex items-center justify-between mb-2">
                        <h2 class="font-bold">{{ 'dashboard.widget.planning_next'|trans }}</h2>
                        <a href="{{ path('admin_planning_index') }}" class="text-xs text-admin-text-muted hover:text-admin-text">{{ 'dashboard.see_all'|trans }} &rarr;</a>
                    </div>
                    <div class="recent-list">
                        {% for event in data.prochains %}
                            <a href="{{ path('admin_planning_index') }}" class="recent-item">
                                <span class="recent-title">{{ event.titre }}</span>
                                <span class="recent-meta">{{ event.date|date_fr('EEE d MMM') }}{{ event.heureDebut ? ' · ' ~ event.heureDebut|date('H:i') }}{{ event.lieu ? ' · ' ~ event.lieu }}</span>
                            </a>
                        {% else %}
                            <p class="text-sm text-admin-text-muted py-2">{{ 'dashboard.planning.none'|trans }}</p>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {% if available.planning_types is defined and data.types_evenements is defined %}
                {% set te = data.types_evenements %}
                {{ ui.chart('planning_types', hidden, 'dashboard.widget.planning_types'|trans, 'dashboard.planning_types.lead'|trans({'%month%': date()|date_fr('LLLL')}),
                    'donut', ['dashboard.planning_kind.training'|trans, 'dashboard.planning_kind.match'|trans, 'dashboard.planning_kind.event'|trans],
                    [{name: '', values: [te.training, te.match, te.event]}], {center: 'dashboard.planning.center'|trans}) }}
            {% endif %}
        </div>
    {% endif %}

    {# ------------------------------------------------------------ Accès rapides #}
    {% if available.quick_links is defined %}
        <h2 class="dash-section">{{ 'dashboard.section.overview'|trans }}</h2>
        <div class="admin-card rounded-2xl p-6 mb-6" data-dashboard-target="widget" data-widget="quick_links" {{ 'quick_links' in hidden ? 'hidden' }}>
            <h2 class="font-bold mb-1">{{ 'dashboard.widget.quick_links'|trans }}</h2>
            <p class="text-sm text-admin-text-muted mb-4">{{ 'dashboard.quick_links.lead'|trans }}</p>
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3 text-sm">
                {% for link in [
                    {route: 'admin_famille_new', icon: 'fa-house-user', label: 'dashboard.quick_links.family'},
                    {route: 'admin_licencie_new', icon: 'fa-id-card', label: 'dashboard.quick_links.member'},
                    {route: 'admin_saison_new', icon: 'fa-calendar-days', label: 'dashboard.quick_links.season'},
                    {route: 'admin_user_new', icon: 'fa-user-plus', label: 'dashboard.quick_links.user'},
                ] %}
                    <a href="{{ path(link.route) }}" class="admin-surface-hover flex items-center gap-3 rounded-xl border border-admin-border px-4 py-3">
                        <span class="flex h-9 w-9 items-center justify-center rounded-lg admin-gradient text-white"><i class="fa-solid {{ link.icon }}"></i></span>
                        {{ link.label|trans }}
                    </a>
                {% endfor %}
            </div>
        </div>
    {% endif %}

