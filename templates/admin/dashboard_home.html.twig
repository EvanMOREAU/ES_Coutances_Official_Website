{# Courbe d'évolution mensuelle (controller line-chart) avec tableau équivalent pour les lecteurs d'écran. #}
{% macro line(title, points, unit, plural = '') %}
    {% set unit_label = unit starts with 'dashboard.' ? unit|trans : unit %}
    <div class="chart"
         data-controller="line-chart"
         data-line-chart-unit-value="{{ unit_label }}"
         {% if unit starts with 'dashboard.' %}data-line-chart-unit-plural-value="{{ (unit ~ '_plural')|trans }}"{% elseif plural %}data-line-chart-unit-plural-value="{{ plural }}"{% endif %}
         data-line-chart-this-month-value="{{ 'dashboard.chart.this_month'|trans }}"
         data-line-chart-none-value="{{ 'dashboard.chart.none_this_month'|trans }}"
         data-line-chart-points-value="{{ points|map(p => {month: p.month|date('Y-m'), total: p.total, new: p.new})|json_encode|e('html_attr') }}">
        <div data-line-chart-target="plot"></div>
        <div class="chart-tooltip" data-line-chart-target="tooltip" hidden></div>
    </div>
    <table class="sr-only">
        <caption>{{ title }}</caption>
        <thead><tr><th>{{ 'dashboard.chart.month'|trans }}</th><th>{{ 'dashboard.chart.total'|trans }}</th><th>{{ 'dashboard.chart.added'|trans }}</th></tr></thead>
        <tbody>
            {% for point in points %}
                <tr><td>{{ point.month|date_fr('MMMM y') }}</td><td>{{ point.total }}</td><td>{{ point.new }}</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endmacro %}

{# Carte de graphique générique (controller chart) : bar | hbar | donut. series = [{name, values}]. #}
{% macro chart(key, hidden, title, subtitle, type, labels, series, opts = {}) %}
    {% set o = {format: 'number', height: 220, center: '', stats: [], wide: false}|merge(opts) %}
    {% set wide = o.wide|default(false) %}
    <div class="admin-card rounded-2xl p-6 {{ wide ? 'lg:col-span-2' }}" data-dashboard-target="widget" data-widget="{{ key }}" {{ key in hidden ? 'hidden' }}>
        <div class="mb-4">
            <h2 class="font-bold">{{ title }}</h2>
            <p class="text-sm text-admin-text-muted">{{ subtitle }}</p>
        </div>
        {% if o.stats|length > 0 %}
            <div class="dash-stat">
                {% for stat in o.stats %}
                    <div><p class="dash-stat-value">{{ stat.value }}</p><p class="dash-stat-label">{{ stat.label }}</p></div>
                {% endfor %}
            </div>
        {% endif %}
        <div class="chart {{ type == 'donut' ? 'chart-donut' : (series|length > 1 ? 'chart-bars-legend') }}"
             data-controller="chart"
             data-chart-type-value="{{ type }}"
             data-chart-format-value="{{ o.format }}"
             data-chart-height-value="{{ o.height }}"
             data-chart-center-label-value="{{ o.center }}"
             data-chart-empty-value="{{ 'dashboard.no_data'|trans }}"
             data-chart-labels-value="{{ labels|json_encode|e('html_attr') }}"
             data-chart-series-value="{{ series|json_encode|e('html_attr') }}">
            <div data-chart-target="plot"></div>
            <div data-chart-target="legend"></div>
            <div class="chart-tooltip" data-chart-target="tooltip" hidden></div>
        </div>
        <table class="sr-only">
            <caption>{{ title }}</caption>
            <thead><tr><th></th>{% for s in series %}<th>{{ s.name }}</th>{% endfor %}</tr></thead>
            <tbody>
                {% for label in labels %}
                    {% set i = loop.index0 %}
                    <tr><th>{{ label }}</th>{% for s in series %}<td>{{ s.values[i] ?? 0 }}</td>{% endfor %}</tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endmacro %}
