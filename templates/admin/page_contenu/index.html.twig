{% extends 'admin/_layout.html.twig' %}

{% block title %}Pages{% endblock %}

{% block body %}
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-black" style="font-family:'Barlow Condensed',sans-serif;">Contenu de page</h1>
        {% if can_url(path('admin_page_contenu_new')) %}<a href="{{ path('admin_page_contenu_new') }}" class="rounded-lg admin-gradient px-4 py-2 text-sm font-semibold text-white">+ Nouvelle page</a>{% endif %}
    </div>

    {% embed 'admin/_components/data_table.html.twig' with {
        key: 'page_contenu',
        plural: 'pages',
        search_placeholder: 'Rechercher une page…',
        empty_message: 'Aucune page ne correspond à votre recherche.',
        bulk_type: 'page_contenu',
        columns: [
            {key: 'titre', label: 'Titre'},
            {key: 'slug', label: 'Slug'},
            {key: 'modifie', label: 'Modifié le'},
        ],
    } %}
        {% block rows %}
            {% for page in pages %}
                <tr data-data-table-target="row" data-id="{{ page.id }}">
                    {% if bulk %}<td class="dt-check-col"><input type="checkbox" data-row-check value="{{ page.id }}" data-action="change->data-table#toggleRow" aria-label="Sélectionner {{ page.titre }}"></td>{% endif %}
                    <td data-col="titre" data-sort="{{ page.titre|lower }}" class="font-medium">{{ page.titre }}</td>
                    <td data-col="slug" class="dt-muted">/page/{{ page.slug }}</td>
                    <td data-col="modifie" data-sort="{{ page.updatedAt ? page.updatedAt|date('Y-m-d H:i') : '' }}" class="dt-muted">{{ page.updatedAt ? page.updatedAt|date('d/m/Y H:i') : '—' }}</td>
                    {% include 'admin/_components/row_menu.html.twig' with {
                        edit_url: path('admin_page_contenu_edit', {id: page.id}),
                        delete_url: path('admin_page_contenu_delete', {id: page.id}),
                        delete_token: csrf_token('delete-page-' ~ page.id),
                        delete_title: 'Supprimer cette page ?',
                        delete_message: 'La page « ' ~ page.titre ~ ' » sera supprimée définitivement.',
                    } %}
                </tr>
            {% endfor %}
        {% endblock %}
    {% endembed %}
{% endblock %}
