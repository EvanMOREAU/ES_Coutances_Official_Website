{% extends 'admin/_layout.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}

{% block title %}{{ categorie.id ? 'Modifier la catégorie' : 'Nouvelle catégorie' }}{% endblock %}

{% block body %}
    <h1 class="u-66972700 text-2xl font-black mb-6">
        {{ categorie.id ? 'Modifier la catégorie' : 'Nouvelle catégorie' }}
    </h1>

    <div class="admin-card rounded-2xl p-6 max-w-xl">
        {{ form_start(form) }}
            {{ form_row(form.nom) }}
            {% if form.nomConfirmation is defined %}
                {{ form_row(form.nomConfirmation) }}
            {% endif %}

            <div class="flex items-center gap-3 mt-6">
                <button type="submit" class="rounded-lg admin-gradient px-5 py-2 text-sm font-semibold text-white">Enregistrer</button>
                <a href="{{ path('admin_categorie_index') }}" class="text-sm text-admin-text-muted hover:text-white">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
