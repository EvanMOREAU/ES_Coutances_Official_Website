{% extends 'admin/_layout.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}

{% block title %}{{ membre.id ? 'Modifier le membre' : 'Nouveau membre' }}{% endblock %}

{% block body %}
    <h1 class="text-2xl font-black mb-6" style="font-family:'Barlow Condensed',sans-serif;">
        {{ membre.id ? 'Modifier le membre' : 'Nouveau membre' }}
    </h1>

    <div class="admin-card rounded-2xl p-6 max-w-xl">
        {{ form_start(form) }}
            {{ form_row(form.nom) }}
            {{ form_row(form.poste) }}
            {{ form_row(form.diplome) }}
            {{ form_row(form.categories) }}
            {{ form_row(form.photoFile) }}
            {{ form_row(form.ordre) }}
            {{ form_row(form.actif) }}

            <div class="flex items-center gap-3 mt-6">
                <button type="submit" class="rounded-lg admin-gradient px-5 py-2 text-sm font-semibold text-white">Enregistrer</button>
                <a href="{{ path('admin_membre_index') }}" class="text-sm text-admin-text-muted hover:text-white">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
