{% extends 'admin/_layout.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}

{% block title %}Réglages{% endblock %}

{% block body %}
    <h1 class="reglage-chrome text-2xl font-black mb-6" style="font-family:'Barlow Condensed',sans-serif;">Réglages</h1>

    {% set tabs = [
        { id: 'accueil', label: 'Accueil', icon: 'fa-image', route: 'admin_reglages_accueil' },
        { id: 'contact', label: 'Contact', icon: 'fa-envelope', route: 'admin_reglages_contact' },
        { id: 'match_live', label: 'Match en live', icon: 'fa-tower-broadcast', route: 'admin_reglages_match_live' },
    ] %}

    {# Onglets masqués dans la grande fenêtre du Site vitrine : chaque rubrique y a sa propre carte #}
    <div class="reglage-chrome flex flex-wrap gap-2 mb-6 border-b border-admin-border pb-3">
        {% for tab in tabs %}
            <a href="{{ path(tab.route) }}"
               class="flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition-colors {{ active_tab == tab.id ? 'admin-gradient text-white' : 'text-admin-text-muted admin-surface-hover hover:text-admin-text' }}">
                <i class="fa-solid {{ tab.icon }}"></i>
                <span>{{ tab.label }}</span>
            </a>
        {% endfor %}
    </div>

    <div class="reglage-card admin-card rounded-2xl p-6 max-w-2xl">
        {% block tab_content %}{% endblock %}
    </div>
{% endblock %}
