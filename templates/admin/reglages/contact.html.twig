{% extends 'admin/reglages/_layout.html.twig' %}

{% block tab_content %}
    {{ form_start(form) }}
        {{ form_row(form.email) }}
        {{ form_row(form.adresse) }}
        {{ form_row(form.telephone) }}
        {{ form_row(form.horaireLundi) }}
        {{ form_row(form.horaireMardi) }}
        {{ form_row(form.horaireMercredi) }}
        {{ form_row(form.horaireJeudi) }}
        {{ form_row(form.horaireVendredi) }}
        {{ form_row(form.horaireSamedi) }}
        {{ form_row(form.horaireDimanche) }}

        <div class="form-actions">
            {{ form_widget(form.save, { attr: { class: 'btn btn-primary action-save' } }) }}
        </div>
    {{ form_end(form) }}
{% endblock %}
