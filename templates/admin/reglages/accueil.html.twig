{% extends 'admin/reglages/_layout.html.twig' %}

{% block tab_content %}
    {{ form_start(form) }}
        {# Dans la grande fenêtre : texte à gauche, image à droite #}
        <div class="reglage-split">
            <div>
                {{ form_row(form.titre) }}
                {{ form_row(form.url) }}
                {{ form_row(form.actif) }}
            </div>
            <div>
                {{ form_row(form.imageFile) }}
            </div>
        </div>

        <div class="mt-4">
            {{ form_widget(form.save) }}
        </div>
    {{ form_end(form) }}
{% endblock %}
