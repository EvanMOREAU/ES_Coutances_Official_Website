{% extends 'admin/_layout.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}

{% block title %}Nouvelle licence{% endblock %}

{% macro reglement_row(row) %}
    <div class="ad-row" data-adhesion-wizard-target="reglement">
        <div class="ad-cell">{{ form_label(row.mode) }}{{ form_widget(row.mode) }}{{ form_errors(row.mode) }}</div>
        <div class="ad-cell">{{ form_label(row.montantCentimes) }}{{ form_widget(row.montantCentimes) }}{{ form_errors(row.montantCentimes) }}</div>
        <div class="ad-cell">{{ form_label(row.dateEcheance) }}{{ form_widget(row.dateEcheance) }}</div>
        <div class="ad-cell ad-check"><label class="sv-toggle">{{ form_widget(row.recu) }}<span class="sv-switch"></span><span>Encaissé</span></label></div>
        <div class="ad-cell">{{ form_label(row.dateRemise) }}{{ form_widget(row.dateRemise) }}</div>
        <div class="ad-cell">{{ form_label(row.reference) }}{{ form_widget(row.reference) }}</div>
        {{ form_widget(row.ordre) }}
        <button type="button" class="var-remove" data-action="adhesion-wizard#remove" title="Retirer" aria-label="Retirer ce règlement"><i class="fa-solid fa-xmark"></i></button>
    </div>
{% endmacro %}

{% macro aide_row(row) %}
    <div class="ad-row" data-adhesion-wizard-target="aide">
        <div class="ad-cell">{{ form_label(row.type) }}{{ form_widget(row.type) }}{{ form_errors(row.type) }}</div>
        <div class="ad-cell">{{ form_label(row.montantCentimes) }}{{ form_widget(row.montantCentimes) }}{{ form_errors(row.montantCentimes) }}</div>
        <div class="ad-cell">{{ form_label(row.statut) }}{{ form_widget(row.statut) }}</div>
        <div class="ad-cell">{{ form_label(row.dateReception) }}{{ form_widget(row.dateReception) }}</div>
        <div class="ad-cell ad-wide">{{ form_label(row.note) }}{{ form_widget(row.note) }}</div>
        <button type="button" class="var-remove" data-action="adhesion-wizard#remove" title="Retirer" aria-label="Retirer cette aide"><i class="fa-solid fa-xmark"></i></button>
    </div>
{% endmacro %}

{% block body %}
    <h1 class="text-2xl font-black mb-1" style="font-family:'Barlow Condensed',sans-serif;">Nouvelle licence</h1>
    <p class="text-sm text-admin-text-muted mb-6">Enregistrez la licence, les aides éventuelles, les règlements et vos observations en une fois.</p>

    {% set next_reglement = 0 %}{% for key, row in form.reglements %}{% set next_reglement = max(next_reglement, key + 1) %}{% endfor %}
    {% set next_aide = 0 %}{% for key, row in form.aides %}{% set next_aide = max(next_aide, key + 1) %}{% endfor %}

    <div data-controller="adhesion-wizard" data-action="change->adhesion-wizard#received keydown.enter->adhesion-wizard#onEnter"
         data-adhesion-wizard-reglement-prototype-value="{{ _self.reglement_row(form.reglements.vars.prototype)|e('html_attr') }}"
         data-adhesion-wizard-aide-prototype-value="{{ _self.aide_row(form.aides.vars.prototype)|e('html_attr') }}"
         data-adhesion-wizard-reglement-index-value="{{ next_reglement }}"
         data-adhesion-wizard-aide-index-value="{{ next_aide }}"
         data-adhesion-wizard-reglement-step-value="2">

        {# Indicateur d'étapes #}
        <div class="flex items-center justify-center gap-3 mb-8 flex-wrap">
            {% for step in [{n: 1, label: 'Licence et montant'}, {n: 2, label: 'Aides'}, {n: 3, label: 'Règlements'}, {n: 4, label: 'Observations'}] %}
                <div class="flex items-center gap-2">
                    <span data-adhesion-wizard-target="indicator" class="flex h-9 w-9 items-center justify-center rounded-full text-sm font-bold {{ loop.first ? 'admin-gradient text-white' : 'bg-admin-surface text-admin-text-muted border border-admin-border' }}">{{ step.n }}</span>
                    <span class="text-sm {{ loop.first ? 'text-admin-text font-medium' : 'text-admin-text-muted' }}">{{ step.label }}</span>
                </div>
                {% if not loop.last %}<div class="w-8 h-px bg-admin-border"></div>{% endif %}
            {% endfor %}
        </div>

        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
            <div class="admin-card rounded-2xl p-6 max-w-3xl mx-auto">

                {# Étape 1 : Licence et montant #}
                <div data-adhesion-wizard-target="step">
                    <h2 class="font-bold mb-4">Licence et montant</h2>

                    <div data-adhesion-wizard-target="licencieField">
                        {{ form_row(form.licencie) }}
                    </div>
                    <div data-adhesion-wizard-target="licencieLabelField" hidden>
                        {{ form_row(form.licencieLabel) }}
                    </div>
                    <p class="text-xs mb-4">
                        <button type="button" class="text-admin-text-muted hover:text-admin-text underline" data-action="adhesion-wizard#toggleMode" data-adhesion-wizard-mode-param="label">
                            La personne n'est pas encore enregistrée comme licencié ?
                        </button>
                        <button type="button" class="text-admin-text-muted hover:text-admin-text underline hidden" data-action="adhesion-wizard#toggleMode" data-adhesion-wizard-mode-param="select">
                            Choisir un licencié existant
                        </button>
                    </p>

                    {{ form_row(form.saison) }}
                    <div class="grid sm:grid-cols-2 gap-4">
                        {{ form_row(form.montantBaseCentimes) }}
                        {{ form_row(form.reductionCentimes) }}
                    </div>
                    {{ form_row(form.reductionMotif) }}
                </div>

                {# Étape 2 : Aides #}
                <div data-adhesion-wizard-target="step" class="hidden">
                    <h2 class="font-bold mb-1">Aides</h2>
                    <p class="text-sm text-admin-text-muted mb-4">Pass'Sport, Spot 50, Atout Normandie, Bourse Évasion, chèques vacances, coupons sport… Optionnel.</p>
                    <div data-adhesion-wizard-target="aides">
                        {% for row in form.aides %}{{ _self.aide_row(row) }}{% endfor %}
                    </div>
                    <p class="ad-empty" data-adhesion-wizard-target="aidesEmpty" {{ form.aides|length > 0 ? 'hidden' }}>Aucune aide enregistrée.</p>
                    <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm mt-3" data-action="adhesion-wizard#addAide"><i class="fa-solid fa-plus"></i> Ajouter une aide</button>
                </div>

                {# Étape 3 : Règlements #}
                <div data-adhesion-wizard-target="step" class="hidden">
                    <div class="flex flex-wrap items-center justify-between gap-3 mb-1">
                        <h2 class="font-bold">Règlements</h2>
                        <div class="ad-split">
                            <span>Échelonner le reste en</span>
                            <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" data-action="adhesion-wizard#split" data-adhesion-wizard-parts-param="1">1 fois</button>
                            <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" data-action="adhesion-wizard#split" data-adhesion-wizard-parts-param="2">2 fois</button>
                            <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" data-action="adhesion-wizard#split" data-adhesion-wizard-parts-param="3">3 fois</button>
                        </div>
                    </div>
                    <p class="text-xs text-admin-text-muted mb-3">Une ligne par échéance. Le reste à régler ci-dessous tient compte des aides et se met à jour si vous revenez les modifier.</p>
                    <p class="ad-resume flex flex-wrap gap-4 text-sm mb-4" data-adhesion-wizard-target="resteResume"></p>
                    {{ form_errors(form.reglements) }}
                    <div data-adhesion-wizard-target="reglements">
                        {% for row in form.reglements %}{{ _self.reglement_row(row) }}{% endfor %}
                    </div>
                    <p class="ad-empty" data-adhesion-wizard-target="reglementsEmpty" {{ form.reglements|length > 0 ? 'hidden' }}>Aucun règlement enregistré.</p>
                    <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm mt-3" data-action="adhesion-wizard#addReglement"><i class="fa-solid fa-plus"></i> Ajouter un règlement</button>
                </div>

                {# Étape 4 : Observations #}
                <div data-adhesion-wizard-target="step" class="hidden">
                    <h2 class="font-bold mb-4">Observations</h2>
                    {{ form_row(form.observation) }}
                </div>

                <div class="flex items-center justify-between mt-6 pt-4 border-t border-admin-border">
                    <button type="button" data-adhesion-wizard-target="backButton" data-action="click->adhesion-wizard#back" class="invisible text-sm text-admin-text-muted hover:text-admin-text">
                        <i class="fa-solid fa-arrow-left mr-1"></i> Précédent
                    </button>
                    <div class="flex items-center gap-3">
                        <a href="{{ path('admin_adhesion_index') }}" class="text-sm text-admin-text-muted hover:text-admin-text">Annuler</a>
                        <button type="button" data-adhesion-wizard-target="nextButton" data-action="click->adhesion-wizard#next"
                                class="rounded-lg admin-gradient px-5 py-2 text-sm font-semibold text-white">
                            Suivant <i class="fa-solid fa-arrow-right ml-1"></i>
                        </button>
                        <button type="submit" data-adhesion-wizard-target="submitButton" class="hidden rounded-lg admin-gradient px-5 py-2 text-sm font-semibold text-white">
                            Créer la licence
                        </button>
                    </div>
                </div>
            </div>

            {% do form.reglements.setRendered %}
            {% do form.aides.setRendered %}
            <div class="hidden">
                {% if form._token is defined %}{{ form_widget(form._token) }}{% endif %}
            </div>
        {{ form_end(form, {render_rest: false}) }}
    </div>
{% endblock %}
