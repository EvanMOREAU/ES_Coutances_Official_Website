{% extends 'admin/_layout.html.twig' %}

{% block title %}Site vitrine{% endblock %}

{% block body %}
    <div class="flex flex-wrap items-start justify-between gap-3 mb-6">
        <div>
            <h1 class="u-66972700 text-2xl font-black">{{ 'Site vitrine'|trans }}</h1>
            <p class="text-sm text-admin-text-muted">{{ 'Tout le contenu du site public au même endroit. Cliquez sur une rubrique pour la gérer.'|trans }}</p>
        </div>
        <a href="{{ path('app_home') }}" target="_blank" rel="noopener" class="admin-btn admin-btn-ghost">
