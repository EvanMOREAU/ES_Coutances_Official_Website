{% extends 'admin/_layout.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}

{% block title %}Paramètres e-mail{% endblock %}

{% macro toggle(field, hint) %}
    <div class="mb-5">
        <label class="sv-toggle">{{ form_widget(field) }}<span class="sv-switch"></span><span><strong>{{ field.vars.label }}</strong>{% if hint %}<small>{{ hint }}</small>{% endif %}</span></label>
        {{ form_errors(field) }}
    </div>
{% endmacro %}

{% block body %}
    <div class="mb-6">
        <h1 class="text-2xl font-black" style="font-family:'Barlow Condensed',sans-serif;">Paramètres e-mail</h1>
        <p class="text-sm text-admin-text-muted">Le serveur qui envoie les e-mails du site : création de mot de passe, confirmations de commande, commande prête…</p>
    </div>

    <div class="admin-card rounded-2xl p-5 mb-6 max-w-3xl flex items-center gap-4">
        <span class="badge {{ settings.utilisable ? 'badge-active' : 'badge-draft' }}">{{ settings.utilisable ? 'Serveur personnalisé actif' : 'Serveur par défaut' }}</span>
        <p class="text-sm text-admin-text-muted">
            {% if settings.utilisable %}Les e-mails partent par <strong>{{ settings.host }}:{{ settings.port }}</strong>{{ settings.username ? ' (compte ' ~ settings.username ~ ')' }}.
            {% else %}Aucun serveur personnalisé n'est activé : l'application utilise celui du fichier d'environnement (<code>MAILER_DSN</code>). Sur un poste de test, c'est souvent un serveur inexistant, d'où des e-mails qui ne partent pas.{% endif %}
        </p>
    </div>

    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        <section class="admin-card rounded-2xl p-6 mb-6 max-w-3xl">
            {{ _self.toggle(form.actif, 'Désactivé, l\'application retombe sur le serveur de l\'environnement.') }}

            <div class="grid gap-4 sm:grid-cols-3">
                <div class="sm:col-span-2">{{ form_row(form.host) }}</div>
                {{ form_row(form.port) }}
            </div>
            {{ form_row(form.chiffrement) }}
            <div class="grid gap-4 sm:grid-cols-2">
                {{ form_row(form.username) }}
                {{ form_row(form.password) }}
            </div>
            {% if settings.hasPassword %}
                <div class="mb-5"><label class="sv-toggle">{{ form_widget(form.retirerMotDePasse) }}<span class="sv-switch"></span><span>{{ form.retirerMotDePasse.vars.label }}</span></label></div>
            {% else %}
                {% do form.retirerMotDePasse.setRendered %}
            {% endif %}
            {{ _self.toggle(form.verifierCertificat, 'À laisser activé. Ne le désactivez que pour un serveur interne avec un certificat auto-signé.') }}
        </section>

        <section class="admin-card rounded-2xl p-6 mb-6 max-w-3xl">
            <h2 class="font-semibold mb-4">Expéditeur</h2>
            <div class="grid gap-4 sm:grid-cols-2">
                {{ form_row(form.expediteurAdresse) }}
                {{ form_row(form.expediteurNom) }}
            </div>
        </section>

        <div class="flex items-center gap-3 mb-8">
            <button type="submit" class="rounded-lg admin-gradient px-5 py-2 text-sm font-semibold text-white">Enregistrer</button>
        </div>
    {{ form_end(form) }}

    {% if can_url(path('admin_mail_test'), 'POST') %}
        <section class="admin-card rounded-2xl p-6 max-w-3xl">
            <h2 class="font-semibold mb-1">Envoyer un e-mail de test</h2>
            <p class="text-xs text-admin-text-muted mb-4">Utilise les paramètres <strong>enregistrés</strong> ci-dessus. Enregistrez avant de tester. En cas d'échec, le message d'erreur du serveur s'affiche.</p>
            <form method="post" action="{{ path('admin_mail_test') }}" class="flex flex-wrap items-end gap-3">
                <input type="hidden" name="_token" value="{{ csrf_token('mail-test') }}">
                <label class="grow">
                    <span class="block text-xs font-semibold uppercase tracking-wide text-admin-text-muted mb-1.5">Envoyer à</span>
                    <input type="email" name="to" value="{{ testTo }}" required class="w-full rounded-lg border border-admin-border bg-admin-bg px-3 py-2 text-sm text-admin-text">
                </label>
                <button type="submit" class="admin-btn admin-btn-primary"><i class="fa-solid fa-paper-plane"></i> Envoyer le test</button>
            </form>
        </section>
    {% endif %}
{% endblock %}
