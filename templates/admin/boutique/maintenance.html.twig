{% extends 'admin/_layout.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}

{% block title %}Réglages de la boutique{% endblock %}

{% block body %}
    <h1 class="u-66972700 text-2xl font-black mb-1">{{ 'Réglages de la boutique'|trans }}</h1>
    <p class="text-sm text-admin-text-muted mb-6">{{ 'Mise en maintenance de la boutique publique (ex. pendant sa mise en place) et seuil d\'alerte de stock.'|trans }}</p>

    <div class="admin-card rounded-2xl p-6 max-w-xl">
        {{ form_start(form) }}
            {{ form_row(form.enMaintenance) }}
            {{ form_row(form.seuilStockBas) }}
            <div class="mt-4">
                {{ form_widget(form.save) }}
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
