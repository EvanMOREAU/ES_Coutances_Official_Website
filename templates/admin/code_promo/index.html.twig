{% extends 'admin/_layout.html.twig' %}

{% block title %}Codes de réduction{% endblock %}

{% block body %}
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-black" style="font-family:'Barlow Condensed',sans-serif;">Codes de réduction</h1>
        {% if can_url(path('admin_code_promo_new')) %}<a href="{{ path('admin_code_promo_new') }}" class="rounded-lg admin-gradient px-4 py-2 text-sm font-semibold text-white">+ Nouveau code</a>{% endif %}
    </div>

    {% embed 'admin/_components/data_table.html.twig' with {
        key: 'code_promo',
        plural: 'codes',
        statuses: false,
        bulk: false,
        search_placeholder: 'Rechercher un code…',
        empty_message: 'Aucun code de réduction ne correspond à votre recherche.',
        columns: [
            {key: 'code', label: 'Code'},
            {key: 'type', label: 'Réduction'},
            {key: 'livraison', label: 'Livraison'},
            {key: 'usage', label: 'Utilisations', type: 'number'},
            {key: 'validite', label: 'Validité'},
            {key: 'statut', label: 'Statut'},
        ],
    } %}
        {% block rows %}
            {% for codePromo in codesPromo %}
                <tr data-data-table-target="row" data-id="{{ codePromo.id }}">
                    <td data-col="code" data-sort="{{ codePromo.code|lower }}" class="font-medium font-mono">{{ codePromo.code }}</td>
                    <td data-col="type" class="dt-muted">
                        {{ codePromo.type == 'pourcentage' ? codePromo.valeur ~ ' %' : (codePromo.valeur / 100)|money }}
                    </td>
                    <td data-col="livraison">
                        {% if codePromo.autoriseLivraison %}<span class="badge badge-active"><i class="fa-solid fa-truck"></i> Oui</span>{% else %}<span class="dt-muted">—</span>{% endif %}
                    </td>
                    <td data-col="usage" data-sort="{{ codePromo.usageActuel }}">
                        {{ codePromo.usageActuel }}{% if codePromo.usageMax %} / {{ codePromo.usageMax }}{% endif %}
                    </td>
                    <td data-col="validite" class="dt-muted">
                        {% if codePromo.dateDebut or codePromo.dateFin %}
                            {{ codePromo.dateDebut ? codePromo.dateDebut|date('d/m/Y') : '…' }} → {{ codePromo.dateFin ? codePromo.dateFin|date('d/m/Y') : '…' }}
                        {% else %}
                            Sans limite
                        {% endif %}
                    </td>
                    <td data-col="statut">
                        {% if codePromo.valide %}
                            <span class="badge badge-active">Valide</span>
                        {% elseif not codePromo.actif %}
                            <span class="badge badge-archived">Désactivé</span>
                        {% else %}
                            <span class="badge badge-draft">Expiré / épuisé</span>
                        {% endif %}
                    </td>
                    {% include 'admin/_components/row_menu.html.twig' with {
                        edit_url: path('admin_code_promo_edit', {id: codePromo.id}),
                        delete_url: path('admin_code_promo_delete', {id: codePromo.id}),
                        delete_token: csrf_token('delete-code-promo-' ~ codePromo.id),
                        delete_title: 'Supprimer ce code ?',
                        delete_message: 'Le code « ' ~ codePromo.code ~ ' » sera supprimé définitivement. Les commandes déjà passées avec ce code conservent leur réduction.',
                    } %}
                </tr>
            {% endfor %}
        {% endblock %}
    {% endembed %}
{% endblock %}
