{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ famille.nomAffiche }}{% endblock %}

{% block body %}
    <p class="mb-4"><a href="{{ path('admin_famille_index') }}" class="text-sm text-admin-text-muted hover:text-white">&larr; Retour aux familles</a></p>

    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-black" style="font-family:'Barlow Condensed',sans-serif;">{{ famille.nomAffiche }}</h1>
        <a href="{{ path('admin_famille_edit', {id: famille.id}) }}" class="rounded-lg admin-gradient px-4 py-2 text-sm font-semibold text-white">Modifier</a>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
        <div class="admin-card rounded-2xl p-6">
            <h2 class="font-bold mb-4">Informations</h2>
            <dl class="text-sm space-y-2">
                <div class="flex justify-between"><dt class="text-admin-text-muted">Compte</dt><dd>{{ famille.user }}{% if not famille.hasEmailValide %} <span class="badge badge-danger ml-1">Email invalide</span>{% endif %}</dd></div>
                <div class="flex justify-between"><dt class="text-admin-text-muted">Adresse</dt><dd>{{ famille.adresse ?? '—' }}</dd></div>
                <div class="flex justify-between"><dt class="text-admin-text-muted">Ville</dt><dd>{{ famille.codePostal }} {{ famille.ville }}</dd></div>
                <div class="flex justify-between"><dt class="text-admin-text-muted">Téléphone</dt><dd>{{ famille.telephone ?? '—' }}</dd></div>
            </dl>
        </div>
        <div class="admin-card rounded-2xl p-6">
            <h2 class="font-bold mb-4">Licenciés rattachés</h2>
            {% if famille.licencies is empty %}
                <p class="text-sm text-admin-text-muted">Aucun licencié rattaché.</p>
            {% else %}
                <ul class="text-sm space-y-2">
                    {% for licencie in famille.licencies %}
                        <li class="flex justify-between">
                            <a href="{{ path('admin_licencie_show', {id: licencie.id}) }}" class="hover:text-white">{{ licencie.prenom }} {{ licencie.nom }}</a>
                            <span class="text-admin-text-muted">{{ licencie.saison }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </div>

    {% if famille.user and not famille.user.staff and not famille.user.anonymized and can_url(path('admin_compte_anonymiser', {id: famille.user.id}), 'POST') %}
        <section class="admin-card rounded-2xl p-6 mt-6" style="border-color: color-mix(in srgb, var(--color-admin-danger) 35%, transparent);">
            <h2 class="font-bold mb-1">Anonymiser le compte</h2>
            <p class="text-sm text-admin-text-muted mb-4">Efface les données personnelles de {{ famille.user.nomComplet ?: famille.user.email }} (compte, famille, licenciés, messages, documents) à sa demande (RGPD). Les factures — licences, règlements, commandes — sont conservées, sans lien avec une identité.</p>
            <form method="post" action="{{ path('admin_compte_anonymiser', {id: famille.user.id}) }}"
                  data-confirm="Les données personnelles de ce compte seront définitivement effacées ; seules les factures seront conservées. Cette action est irréversible." data-confirm-title="Anonymiser ce compte ?" data-confirm-label="Anonymiser">
                <input type="hidden" name="_token" value="{{ csrf_token('anonymize-compte-' ~ famille.user.id) }}">
                <input type="hidden" name="retour" value="{{ path('admin_famille_index') }}">
                <button type="submit" class="rounded-lg border border-admin-danger/40 text-admin-danger px-4 py-2 text-sm font-semibold hover:bg-admin-danger/10"><i class="fa-solid fa-user-slash"></i> Anonymiser le compte</button>
            </form>
        </section>
    {% endif %}
{% endblock %}
