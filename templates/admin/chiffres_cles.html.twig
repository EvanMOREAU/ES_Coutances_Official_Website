{% extends '@EasyAdmin/layout.html.twig' %}

{% form_theme form '@EasyAdmin/crud/form_theme.html.twig' %}

{% block content_title %}Chiffres clés{% endblock %}

{% block main %}
    {# Les spinners natifs des <input type="number"> ne suivent pas toujours le
       color-scheme hérité du body en mode sombre (carré blanc sur fond sombre
       dans certains navigateurs) : on les masque et on force le color-scheme
       localement pour un rendu cohérent quel que soit le navigateur. #}
    <style>
        .content-panel input[type=number] {
            color-scheme: light dark;
        }
        .content-panel input[type=number]::-webkit-inner-spin-button,
        .content-panel input[type=number]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        .content-panel input[type=number] {
            -moz-appearance: textfield;
        }
    </style>
    <div class="content-panel">
        <div class="content-panel-body">
            {{ form_start(form) }}
                {{ form_row(form.nbLicencies) }}
                {{ form_row(form.nbEducateurs) }}
                {{ form_row(form.nbBenevoles) }}

                <div class="form-actions">
                    {{ form_widget(form.save, { attr: { class: 'btn btn-primary action-save' } }) }}
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
