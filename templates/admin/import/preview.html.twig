{% extends 'admin/_layout.html.twig' %}

{% block title %}Aperçu de l'import{% endblock %}

{% block body %}
    <div class="mb-6">
        <h1 class="text-2xl font-black" style="font-family:'Barlow Condensed',sans-serif;">Aperçu de l'import</h1>
        <p class="text-sm text-admin-text-muted">Vérifiez ce qui va être créé ou mis à jour, puis confirmez pour écrire en base.</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
        <div class="admin-card rounded-xl p-4">
            <p class="text-2xl font-black">{{ preview.summary.famillesNouvelles }}</p>
            <p class="text-xs text-admin-text-muted">Famille(s) nouvelle(s)</p>
        </div>
        <div class="admin-card rounded-xl p-4">
            <p class="text-2xl font-black">{{ preview.summary.famillesExistantes }}</p>
            <p class="text-xs text-admin-text-muted">Famille(s) déjà connue(s)</p>
        </div>
        <div class="admin-card rounded-xl p-4">
            <p class="text-2xl font-black">{{ preview.summary.licenciesNouveaux }}</p>
            <p class="text-xs text-admin-text-muted">Licencié(s) nouveau(x)</p>
        </div>
        <div class="admin-card rounded-xl p-4">
            <p class="text-2xl font-black">{{ preview.summary.licenciesMisAJour }}</p>
            <p class="text-xs text-admin-text-muted">Licencié(s) mis à jour</p>
        </div>
    </div>

    <div class="admin-card rounded-2xl overflow-hidden mb-6">
        <table class="w-full text-sm">
            <thead class="bg-admin-surface text-left text-xs uppercase tracking-wide text-admin-text-muted">
                <tr>
                    <th class="px-4 py-3">Famille</th>
                    <th class="px-4 py-3">Licencié</th>
                    <th class="px-4 py-3">Né(e) le</th>
                    <th class="px-4 py-3">Catégorie</th>
                    <th class="px-4 py-3">N° personne FFF</th>
                    <th class="px-4 py-3">Statut</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-admin-border">
                {% for group in preview.groups %}
                    {% for licencie in group.licencies %}
                        <tr>
                            {% if loop.first %}
                                <td class="px-4 py-2 align-top font-medium" rowspan="{{ group.licencies|length }}">
                                    {{ group.nom }}
                                    <span class="badge {{ group.status == 'new' ? 'badge-draft' : 'badge-active' }} ml-1">
                                        {{ group.status == 'new' ? 'Nouvelle famille' : 'Famille existante' }}
                                    </span>
                                </td>
                            {% endif %}
                            <td class="px-4 py-2">{{ licencie.prenom }} {{ licencie.nom }}</td>
                            <td class="px-4 py-2 dt-muted">{{ licencie.dateNaissance ? licencie.dateNaissance|date('d/m/Y') : '—' }}</td>
                            <td class="px-4 py-2 dt-muted">{{ licencie.codeCategorie ?? '—' }}</td>
                            <td class="px-4 py-2 dt-muted">{{ licencie.numeroPersonne ?? '—' }}</td>
                            <td class="px-4 py-2">
                                {% if licencie.status == 'new' %}
                                    <span class="badge badge-draft">Nouveau</span>
                                {% else %}
                                    <span class="badge badge-active">Mise à jour</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                {% endfor %}
            </tbody>
        </table>
    </div>

    <form method="post" action="{{ path('admin_import_confirm') }}" class="flex items-center gap-3">
        <input type="hidden" name="_token" value="{{ csrf_token('import-confirm') }}">
        <button type="submit" class="rounded-lg admin-gradient px-5 py-2 text-sm font-semibold text-white">
            <i class="fa-solid fa-check"></i> Confirmer l'import
        </button>
        <a href="{{ path('admin_import_index') }}" class="rounded-lg border border-admin-border px-5 py-2 text-sm font-semibold">Annuler</a>
    </form>
{% endblock %}
