{#
 Matrice d'autorisations : une ligne par élément du site, une colonne par action.
 Variables : selected (liste de codes cochés), disabled? (lecture seule).
 Les cases envoient permissions[] ; permission_matrix_controller.js gère « tout cocher » et les dépendances
 (créer / modifier / supprimer impliquent voir).
#}
{% set standard = {voir: 'Voir', creer: 'Créer', modifier: 'Modifier', supprimer: 'Supprimer'} %}
<div class="pm" data-controller="permission-matrix">
    <div class="pm-toolbar">
        <span class="pm-count"><strong data-permission-matrix-target="count">0</strong> autorisation<span data-permission-matrix-target="plural"></span> accordée<span data-permission-matrix-target="plural"></span></span>
        <span class="pm-quick">
            <label class="sv-toggle pm-master"><input type="checkbox" data-permission-matrix-target="master" data-action="permission-matrix#master"><span class="sv-switch"></span><span>Toutes les autorisations</span></label>
            <button type="button" class="pm-link" data-action="permission-matrix#readOnly">Lecture seule</button>
        </span>
    </div>

    {% for group, resources in permission_groups() %}
        <section class="pm-group">
            <header>
                <h3>{{ group }}</h3>
                <label class="sv-toggle sv-toggle-sm"><input type="checkbox" data-permission-matrix-target="groupMaster" data-action="permission-matrix#groupToggle"><span class="sv-switch"></span><span>Toute la rubrique</span></label>
            </header>
            <div class="pm-scroll">
                <table class="pm-table">
                    <thead>
                        <tr>
                            <th>Élément</th>
                            {% for label in standard %}<th>{{ label }}</th>{% endfor %}
                            <th>Actions particulières</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for key, resource in resources %}
                            <tr data-resource="{{ key }}">
                                <th scope="row">
                                    {{ resource.label }}
                                    <label class="sv-toggle sv-toggle-sm pm-rowtoggle" title="Tout cocher pour cette ligne"><input type="checkbox" data-permission-matrix-target="rowMaster" data-action="permission-matrix#rowToggle" aria-label="Toutes les autorisations : {{ resource.label }}"><span class="sv-switch"></span></label>
                                </th>
                                {% for action, label in standard %}
                                    <td>
                                        {% if resource.actions[action] is defined %}
                                            {% set code = key ~ '.' ~ action %}
                                            <input type="checkbox" name="permissions[]" value="{{ code }}" data-action="permission-matrix#changed"
                                                   aria-label="{{ resource.label }} — {{ resource.actions[action] }}" {{ code in selected ? 'checked' }} {{ disabled|default(false) ? 'disabled' }}>
                                        {% else %}<span class="pm-none">—</span>{% endif %}
                                    </td>
                                {% endfor %}
                                <td class="pm-extra">
                                    {% for action, label in resource.actions %}
                                        {% if standard[action] is not defined %}
                                            {% set code = key ~ '.' ~ action %}
                                            <label><input type="checkbox" name="permissions[]" value="{{ code }}" data-action="permission-matrix#changed" {{ code in selected ? 'checked' }} {{ disabled|default(false) ? 'disabled' }}> {{ label }}</label>
                                        {% endif %}
                                    {% endfor %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% endfor %}
</div>
