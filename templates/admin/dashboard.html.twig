{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}
<div style="padding:32px;">
    <h1 style="font-family:'Barlow Condensed',sans-serif;font-size:32px;font-weight:900;text-transform:uppercase;margin-bottom:8px;">
        Bienvenue, {{ app.user.nom }}
    </h1>
    <p style="color:var(--text-muted);margin-bottom:32px;">Gérez le contenu du site ES Coutances.</p>

    {% if kpis is defined and kpis|length %}
        <div class="admin-kpi-grid">
            {% for kpi in kpis %}
                <div class="admin-kpi-card">
                    <div class="admin-kpi-icon"><i class="fa {{ kpi.icon }}"></i></div>
                    <div>
                        <div class="admin-kpi-value">{{ kpi.value }}</div>
                        <div class="admin-kpi-label">{{ kpi.label }}</div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {% macro card(url, icon, label) %}
        <a href="{{ url }}" class="admin-card">
            <div class="admin-card-icon"><i class="fa {{ icon }}"></i></div>
            <div class="admin-card-label">{{ label }}</div>
        </a>
    {% endmacro %}

    {# ---- Section Développeur ---- #}
    {% if is_granted('ROLE_DEV') %}
        <div class="admin-section-title">Développeur</div>
        <div class="admin-card-grid">
            {{ _self.card(
                ea_url().setController('App\\Controller\\Admin\\CategorieCrudController').setAction('index'),
                'fa-tags', 'Catégories encadrement'
            ) }}
        </div>
    {% endif %}

    {# ---- Section Club ---- #}
    {% if is_granted('ROLE_ADMIN') %}
        <div class="admin-section-title">Club</div>
        <div class="admin-card-grid">
            {{ _self.card(
                ea_url().setController('App\\Controller\\Admin\\PartenaireCrudController').setAction('index'),
                'fa-handshake', 'Partenaires & Sponsors'
            ) }}
            {{ _self.card(
                ea_url().setController('App\\Controller\\Admin\\OffreEmploiCrudController').setAction('index'),
                'fa-briefcase', "Offres d'emploi"
            ) }}
            {{ _self.card(
                ea_url().setController('App\\Controller\\Admin\\SlideCarouselCrudController').setAction('index'),
                'fa-sliders', 'Carousel'
            ) }}
            {{ _self.card(
                ea_url().setController('App\\Controller\\Admin\\PageContenuCrudController').setAction('index'),
                'fa-file-lines', 'Pages'
            ) }}
            {{ _self.card(
                ea_url().setController('App\\Controller\\Admin\\MembreCrudController').setAction('index'),
                'fa-people-group', 'Encadrement'
            ) }}
            {{ _self.card(
                path('admin_reglages_accueil'),
                'fa-sliders', 'Réglages'
            ) }}
        </div>

        {# ---- Section Administration ---- #}
        <div class="admin-section-title">Administration</div>
        <div class="admin-card-grid">
            {{ _self.card(
                ea_url().setController('App\\Controller\\Admin\\UserCrudController').setAction('index'),
                'fa-users', 'Utilisateurs'
            ) }}
        </div>
    {% endif %}

    {# ---- Section Mon compte (tous les utilisateurs connectés) ---- #}
    <div class="admin-section-title">Mon compte</div>
    <div class="admin-card-grid">
        {{ _self.card(path('admin_reglages_compte'), 'fa-key', 'Changer mon mot de passe') }}
        {{ _self.card(path('app_home'), 'fa-eye', 'Voir le site') }}
    </div>

</div>
{% endblock %}
