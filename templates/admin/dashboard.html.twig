{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}
<div style="padding:32px;">
    <h1 style="font-family:'Barlow Condensed',sans-serif;font-size:32px;font-weight:900;text-transform:uppercase;margin-bottom:8px;">
        Bienvenue, {{ app.user.nom }}
    </h1>
    <p style="color:#666;margin-bottom:32px;">Gérez le contenu du site ES Coutances.</p>

    {% macro card(url, icon, label) %}
        <a href="{{ url }}"
           style="background:#fff;border:1px solid #e5e7eb;border-radius:8px;padding:24px;text-decoration:none;color:#0D0D0D;display:block;transition:box-shadow .2s"
           onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,.1)'"
           onmouseout="this.style.boxShadow='none'">
            <div style="font-size:28px;color:#C8102E;margin-bottom:8px;"><i class="fa {{ icon }}"></i></div>
            <div style="font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:.05em;">{{ label }}</div>
        </a>
    {% endmacro %}

    {# ---- Section Développeur ---- #}
    {% if is_granted('ROLE_DEV') %}
        <div style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#C8102E;margin-bottom:12px;padding-bottom:6px;border-bottom:2px solid #e5e7eb;">
            Développeur
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px;margin-bottom:32px;">
            {{ _self.card(
                ea_url().setController('App\\Controller\\Admin\\CategorieCrudController').setAction('index'),
                'fa-tags', 'Catégories encadrement'
            ) }}
        </div>
    {% endif %}

    {# ---- Section Club ---- #}
    {% if is_granted('ROLE_ADMIN') %}
        <div style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#C8102E;margin-bottom:12px;padding-bottom:6px;border-bottom:2px solid #e5e7eb;">
            Club
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px;margin-bottom:32px;">
            {{ _self.card(
                ea_url().setController('App\\Controller\\Admin\\PartenaireCrudController').setAction('index'),
                'fa-handshake', 'Partenaires & Sponsors'
            ) }}
            {{ _self.card(
                ea_url().setController('App\\Controller\\Admin\\OffreEmploiCrudController').setAction('index'),
                'fa-briefcase', "Offres d'emploi"
            ) }}
            {{ _self.card(
                ea_url().setController('App\\Controller\\Admin\\SlideCarouselCrudController').setAction('index'),
                'fa-sliders', 'Carousel'
            ) }}
            {{ _self.card(
                ea_url().setController('App\\Controller\\Admin\\PageContenuCrudController').setAction('index'),
                'fa-file-lines', 'Pages'
            ) }}
            {{ _self.card(
                ea_url().setController('App\\Controller\\Admin\\MembreCrudController').setAction('index'),
                'fa-people-group', 'Encadrement'
            ) }}
            {{ _self.card(
                path('admin_chiffres_cles'),
                'fa-chart-simple', 'Chiffres clés'
            ) }}
            {{ _self.card(
                path('admin_match_live'),
                'fa-tower-broadcast', 'Match en Live'
            ) }}
        </div>

        {# ---- Section Administration ---- #}
        <div style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#C8102E;margin-bottom:12px;padding-bottom:6px;border-bottom:2px solid #e5e7eb;">
            Administration
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px;margin-bottom:32px;">
            {{ _self.card(
                ea_url().setController('App\\Controller\\Admin\\UserCrudController').setAction('index'),
                'fa-users', 'Utilisateurs'
            ) }}
            {{ _self.card(
                path('admin_contact_settings'),
                'fa-envelope', 'Page de contact'
            ) }}
        </div>
    {% endif %}

    {# ---- Section Mon compte (tous les utilisateurs connectés) ---- #}
    <div style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#C8102E;margin-bottom:12px;padding-bottom:6px;border-bottom:2px solid #e5e7eb;">
        Mon compte
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px;margin-bottom:32px;">
        {{ _self.card(path('admin_account_password'), 'fa-key', 'Changer mon mot de passe') }}
        {{ _self.card(path('app_home'), 'fa-eye', 'Voir le site') }}
    </div>

</div>
{% endblock %}