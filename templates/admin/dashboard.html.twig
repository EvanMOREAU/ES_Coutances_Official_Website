{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}
<div style="padding:32px;">
    <h1 style="font-family:'Barlow Condensed',sans-serif;font-size:32px;font-weight:900;text-transform:uppercase;margin-bottom:8px;">
        Bienvenue, {{ app.user.nom }}
    </h1>
    <p style="color:#666;margin-bottom:32px;">Gérez le contenu du site ES Coutances.</p>

    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px;">

        <a href="{{ ea_url().setController('App\\Controller\\Admin\\ArticleCrudController').setAction('index') }}"
           style="background:#fff;border:1px solid #e5e7eb;border-radius:8px;padding:24px;text-decoration:none;color:#0D0D0D;display:block;transition:box-shadow .2s"
           onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,.1)'"
           onmouseout="this.style.boxShadow='none'">
            <div style="font-size:28px;color:#C8102E;margin-bottom:8px;"><i class="fa fa-newspaper"></i></div>
            <div style="font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:.05em;">Actualités</div>
        </a>

        <a href="{{ ea_url().setController('App\\Controller\\Admin\\AlbumCrudController').setAction('index') }}"
           style="background:#fff;border:1px solid #e5e7eb;border-radius:8px;padding:24px;text-decoration:none;color:#0D0D0D;display:block;transition:box-shadow .2s"
           onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,.1)'"
           onmouseout="this.style.boxShadow='none'">
            <div style="font-size:28px;color:#C8102E;margin-bottom:8px;"><i class="fa fa-images"></i></div>
            <div style="font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:.05em;">Albums photos</div>
        </a>

        <a href="{{ ea_url().setController('App\\Controller\\Admin\\PhotoCrudController').setAction('index') }}"
           style="background:#fff;border:1px solid #e5e7eb;border-radius:8px;padding:24px;text-decoration:none;color:#0D0D0D;display:block;transition:box-shadow .2s"
           onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,.1)'"
           onmouseout="this.style.boxShadow='none'">
            <div style="font-size:28px;color:#C8102E;margin-bottom:8px;"><i class="fa fa-image"></i></div>
            <div style="font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:.05em;">Photos</div>
        </a>

        {% if is_granted('ROLE_ADMIN') %}

        <a href="{{ ea_url().setController('App\\Controller\\Admin\\EquipeCrudController').setAction('index') }}"
           style="background:#fff;border:1px solid #e5e7eb;border-radius:8px;padding:24px;text-decoration:none;color:#0D0D0D;display:block;transition:box-shadow .2s"
           onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,.1)'"
           onmouseout="this.style.boxShadow='none'">
            <div style="font-size:28px;color:#C8102E;margin-bottom:8px;"><i class="fa fa-shield"></i></div>
            <div style="font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:.05em;">Équipes</div>
        </a>

        <a href="{{ ea_url().setController('App\\Controller\\Admin\\OffreEmploiCrudController').setAction('index') }}"
           style="background:#fff;border:1px solid #e5e7eb;border-radius:8px;padding:24px;text-decoration:none;color:#0D0D0D;display:block;transition:box-shadow .2s"
           onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,.1)'"
           onmouseout="this.style.boxShadow='none'">
            <div style="font-size:28px;color:#C8102E;margin-bottom:8px;"><i class="fa fa-briefcase"></i></div>
            <div style="font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:.05em;">Offres d'emploi</div>
        </a>

        <a href="{{ ea_url().setController('App\\Controller\\Admin\\PartenaireCrudController').setAction('index') }}"
           style="background:#fff;border:1px solid #e5e7eb;border-radius:8px;padding:24px;text-decoration:none;color:#0D0D0D;display:block;transition:box-shadow .2s"
           onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,.1)'"
           onmouseout="this.style.boxShadow='none'">
            <div style="font-size:28px;color:#C8102E;margin-bottom:8px;"><i class="fa fa-handshake"></i></div>
            <div style="font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:.05em;">Partenaires et Sponsors</div>
        </a>

        <a href="{{ ea_url().setController('App\\Controller\\Admin\\SlideCarouselCrudController').setAction('index') }}"
           style="background:#fff;border:1px solid #e5e7eb;border-radius:8px;padding:24px;text-decoration:none;color:#0D0D0D;display:block;transition:box-shadow .2s"
           onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,.1)'"
           onmouseout="this.style.boxShadow='none'">
            <div style="font-size:28px;color:#C8102E;margin-bottom:8px;"><i class="fa fa-sliders"></i></div>
            <div style="font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:.05em;">Carousel</div>
        </a>

        {% endif %}

    </div>
</div>
{% endblock %}