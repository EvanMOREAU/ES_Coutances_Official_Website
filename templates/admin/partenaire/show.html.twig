{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ partenaire.nom }}{% endblock %}

{% block body %}
    <p class="mb-4"><a href="{{ path('admin_partenaire_index') }}" class="text-sm text-admin-text-muted hover:text-white">&larr; Retour aux partenaires</a></p>

    <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
            {% if partenaire.logoName %}
                <img src="{{ asset('uploads/partenaires/' ~ partenaire.logoName) }}" alt="" class="h-10 w-10 rounded object-cover bg-white/10">
            {% endif %}
            <h1 class="text-2xl font-black" style="font-family:'Barlow Condensed',sans-serif;">{{ partenaire.nom }}</h1>
            <span class="badge badge-{{ partenaire.statut }}">{{ partenaire.statutLabel }}</span>
        </div>
        <a href="{{ path('admin_partenaire_edit', {id: partenaire.id}) }}" class="rounded-lg admin-gradient px-4 py-2 text-sm font-semibold text-white">Modifier</a>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
        <div class="admin-card rounded-2xl p-6">
            <h2 class="font-bold mb-4">Informations</h2>
            <dl class="text-sm space-y-2">
                <div class="flex justify-between"><dt class="text-admin-text-muted">Catégorie</dt><dd>{{ partenaire.categorie ? partenaire.categorie.nom : '—' }}</dd></div>
                <div class="flex justify-between"><dt class="text-admin-text-muted">Site web</dt><dd>{{ partenaire.url ?? '—' }}</dd></div>
                <div class="flex justify-between"><dt class="text-admin-text-muted">Ajouté le</dt><dd>{{ partenaire.createdAt ? partenaire.createdAt|date('d/m/Y') : '—' }}</dd></div>
            </dl>
        </div>

        <div class="md:col-span-2 admin-card rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
                <h2 class="font-bold">Contrats</h2>
                {% if can_url(path('admin_partenaire_contrat_new')) %}
                    <a href="{{ path('admin_partenaire_contrat_new', {partenaire: partenaire.id}) }}" class="rounded-lg admin-gradient px-3 py-1.5 text-xs font-semibold text-white">+ Nouveau contrat</a>
                {% endif %}
            </div>
            {% if partenaire.contrats is empty %}
                <p class="text-sm text-admin-text-muted">Aucun contrat pour le moment.</p>
            {% else %}
                <ul class="text-sm space-y-3">
                    {% for contrat in partenaire.contrats %}
                        <li>
                            <a href="{{ path('admin_partenaire_contrat_show', {id: contrat.id}) }}" class="block rounded-xl border border-admin-border p-4 hover:border-admin-text-muted transition-colors">
                                <div class="flex items-center justify-between gap-3 mb-1">
                                    <span class="font-medium">{{ contrat.titre }}</span>
                                    <span class="badge badge-pay-{{ contrat.statutPaiement }}">{{ contrat.statutPaiementLabel }}</span>
                                </div>
                                <div class="flex items-center justify-between gap-3 text-xs text-admin-text-muted">
                                    <span>
                                        {% if contrat.dateDebut or contrat.dateFin %}
                                            {{ contrat.dateDebut ? contrat.dateDebut|date('d/m/Y') : '…' }} → {{ contrat.dateFin ? contrat.dateFin|date('d/m/Y') : '…' }}
                                        {% else %}
                                            Sans période définie
                                        {% endif %}
                                        · {{ contrat.montantCentimes|money }}
                                    </span>
                                    {% if contrat.tachesTotal > 0 %}
                                        <span><i class="fa-solid fa-list-check"></i> {{ contrat.tachesTotal - contrat.tachesRestantes }} / {{ contrat.tachesTotal }} tâche{{ contrat.tachesTotal > 1 ? 's' }}</span>
                                    {% endif %}
                                </div>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </div>
{% endblock %}
