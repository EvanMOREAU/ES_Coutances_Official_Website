# Configuration Apache (mod_rewrite, mod_headers, mod_deflate, mod_expires).
# Si le serveur est Nginx, voir deploy/nginx.conf.example : ce fichier est alors ignoré.

DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Tout passe en HTTPS (le reste du site compte dessus : cookies, HSTS, paiement).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Transmet l'en-tête Authorization à PHP.
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Tout fichier ou dossier inexistant est traité par le contrôleur frontal.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Jamais de fichiers cachés (.env, .git…) ni de sauvegardes.
<FilesMatch "(^\.|\.(sql|bak|old|orig|log|dist|lock)$)">
    Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# Fichiers versionnés par AssetMapper (/assets/…-<empreinte>.css|js|woff2) : cache longue durée.
<IfModule mod_expires.c>
    ExpiresActive On
    <FilesMatch "\.(woff2|ico)$">
        ExpiresDefault "access plus 1 year"
    </FilesMatch>
    <IfModule mod_headers.c>
        <If "%{REQUEST_URI} =~ m#^/assets/#">
            Header set Cache-Control "public, max-age=31536000, immutable"
        </If>
    </IfModule>
    ExpiresByType image/png  "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
</IfModule>
