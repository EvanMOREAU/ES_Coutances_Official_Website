# Exemple de site Nginx + PHP-FPM pour escoutances.fr (adapter les chemins et la version de PHP).
server {
    listen 80;
    server_name escoutances.fr www.escoutances.fr;
    return 301 https://escoutances.fr$request_uri;
}

server {
    listen 443 ssl http2;
    server_name escoutances.fr;

    ssl_certificate     /etc/letsencrypt/live/escoutances.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/escoutances.fr/privkey.pem;

    root /var/www/escoutances/public;
    index index.php;
    client_max_body_size 20m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/xml application/xml;

    # Jamais de fichiers cachés ni de sauvegardes.
    location ~ /\.(?!well-known) { deny all; }
    location ~* \.(sql|bak|old|orig|log|dist|lock)$ { deny all; }

    # Fichiers versionnés par AssetMapper : cache longue durée.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Fichiers envoyés par les utilisateurs : aucun script PHP ne doit s'y exécuter.
    location ^~ /uploads/ {
        expires 30d;
        location ~ \.php$ { return 403; }
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.php$is_args$args;
    }

    location ~ ^/index\.php(/|$) {
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        internal;
    }

    # Tout autre .php est refusé.
    location ~ \.php$ { return 404; }
}
